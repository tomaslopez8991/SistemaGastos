@model List<SistemaGastos.Application.ViewModels.BudgetStatusViewModel>

@if (Model == null || Model.Count == 0)
{
    <div class="col-12 text-center py-5">
        <div class="opacity-50 mb-3">
            <i class="fa-solid fa-piggy-bank fs-1"></i>
        </div>
        <h5 class="text-body-secondary fw-bold">Tu hoja está en blanco este mes</h5>
        <p class="text-body-secondary small mb-4">No has definido límites para este periodo.</p>

        <div class="d-flex justify-content-center gap-3">
            <button class="btn btn-outline-warning fw-bold shadow-sm" onclick="abrirModalPresupuesto()">
                <i class="fa-solid fa-plus me-2"></i> Crear desde Cero
            </button>
            <button class="btn btn-primary fw-bold shadow-sm" onclick="copiarMesAnterior()">
                <i class="fa-solid fa-copy me-2"></i> Copiar del Mes Anterior
            </button>
        </div>
    </div>
}
else
{
    // CÁLCULOS GLOBALES
    decimal totalLimit = Model.Sum(x => x.Limit);
    decimal totalSpent = Model.Sum(x => x.Spent);
    decimal totalRemaining = totalLimit - totalSpent;
    int totalPercentage = totalLimit == 0 ? 0 : (int)((totalSpent / totalLimit) * 100);
    int visualPercentage = totalPercentage > 100 ? 100 : totalPercentage;

    string statusColor = totalRemaining < 0 ? "bg-danger" : (totalPercentage >= 80 ? "bg-warning" : "bg-primary");
    string textColor = totalRemaining < 0 ? "text-danger-emphasis" : "text-success-emphasis";
    string icon = totalRemaining < 0 ? "fa-triangle-exclamation text-danger" : "fa-scale-balanced text-primary";

    <div class="col-12 mb-4">
        <div class="card bg-body border-secondary-subtle shadow-sm overflow-hidden">
            <div class="card-body p-4">
                <div class="row align-items-center text-center text-md-start">
                    <div class="col-md-3 border-end border-secondary-subtle mb-3 mb-md-0 d-flex flex-column align-items-center">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-secondary-subtle mb-2" style="width: 60px; height: 60px;">
                            <i class="fa-solid @icon fs-3"></i>
                        </div>
                        <h6 class="fw-bold mb-0 text-body-emphasis">Balance General</h6>
                    </div>

                    <div class="col-md-9">
                        <div class="row text-center mb-3">
                            <div class="col-4">
                                <small class="text-body-secondary text-uppercase fw-bold" style="font-size: 0.7rem;">Límite</small>
                                <h4 class="fw-bold mb-0 text-body-emphasis">$ @totalLimit.ToString("N0")</h4>
                            </div>
                            <div class="col-4 border-start border-end border-secondary-subtle">
                                <small class="text-body-secondary text-uppercase fw-bold" style="font-size: 0.7rem;">Gastado</small>
                                <h4 class="@(totalSpent > totalLimit ? "text-danger-emphasis" : "text-body-emphasis") fw-bold mb-0">
                                    $ @totalSpent.ToString("N0")
                                </h4>
                            </div>
                            <div class="col-4">
                                <small class="text-body-secondary text-uppercase fw-bold" style="font-size: 0.7rem;">Disponible</small>
                                <h4 class="@textColor fw-bold mb-0">$ @totalRemaining.ToString("N0")</h4>
                            </div>
                        </div>
                        <div class="progress bg-secondary-subtle" style="height: 12px; border-radius: 6px;">
                            <div class="progress-bar @statusColor progress-bar-striped progress-bar-animated" style="width: @visualPercentage%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card bg-body-tertiary border-0 shadow-sm h-100 position-relative overflow-hidden">
                    <div class="position-absolute top-0 start-0 h-100" style="width: 4px; background-color: @item.CategoryColor;"></div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 35px; height: 35px; background-color: @item.CategoryColor;">
                                    <i class="@item.CategoryIcon"></i>
                                </div>
                                <h6 class="fw-bold mb-0 text-body-emphasis">@item.CategoryName</h6>
                            </div>
                            <div class="dropdown">
                                <button class="btn btn-link text-body-secondary p-0" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li><a class="dropdown-item" href="#" onclick="verDetallePresupuesto(@item.ID)"><i class="fa-solid fa-list-ul me-2 text-info"></i> Detalle</a></li>
                                    <li><a class="dropdown-item" href="#" onclick="abrirModalPresupuesto(@item.ID)"><i class="fa-solid fa-pen me-2 text-primary"></i> Editar</a></li>
                                    <li><a class="dropdown-item text-danger" href="#" onclick="eliminarPresupuesto(@item.ID)"><i class="fa-solid fa-trash me-2"></i> Eliminar</a></li>
                                </ul>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-end mt-3 mb-2">
                            <div>
                                <small class="text-body-secondary d-block" style="font-size: 0.75rem;">GASTADO</small>
                                <span class="fw-bold fs-5 @(item.Remaining < 0 ? "text-danger-emphasis" : "text-body-emphasis")">$ @item.Spent.ToString("N0")</span>
                            </div>
                            <div class="text-end">
                                <small class="text-body-secondary d-block" style="font-size: 0.75rem;">LÍMITE</small>
                                <span class="fw-bold text-body-emphasis">$ @item.Limit.ToString("N0")</span>
                            </div>
                        </div>

                        <div class="progress bg-secondary-subtle" style="height: 8px; border-radius: 4px;">
                            <div class="progress-bar @item.StatusColor" style="width: @item.PercentageVisual%"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}