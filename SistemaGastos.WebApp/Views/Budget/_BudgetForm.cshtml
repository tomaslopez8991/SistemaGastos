@model SistemaGastos.Domain.Models.Budget
@{
    Layout = null;
}

<form id="form-budget">
    <input type="hidden" asp-for="ID" />
    <input type="hidden" id="PeriodMonth" name="PeriodMonth" value="@Model.PeriodMonth" />
    <input type="hidden" id="PeriodYear" name="PeriodYear" value="@Model.PeriodYear" />

    <div class="alert bg-info-subtle border-info-subtle text-info-emphasis py-2 small mb-4">
        <i class="fa-solid fa-calendar-day me-2"></i> Presupuesto para: <strong>@Model.PeriodMonth / @Model.PeriodYear</strong>
    </div>

    <div class="mb-3 text-start">
        <label asp-for="CategoryID" class="form-label text-body-emphasis fw-bold small text-uppercase">Categoría a controlar</label>
        <select asp-for="CategoryID" class="form-select bg-body" asp-items="ViewBag.Categories" required>
            <option value="">Selecciona...</option>
        </select>
    </div>

    <div class="mb-4 text-start">
        <label asp-for="AmountLimit" class="form-label text-body-emphasis fw-bold small text-uppercase">Límite Mensual</label>
        <div class="input-group shadow-sm">
            <span class="input-group-text bg-body-tertiary text-body-secondary">$</span>
            <input asp-for="AmountLimit" type="number" step="0.01" class="form-control fw-bold fs-5 text-primary-emphasis bg-body" placeholder="0.00" required />
        </div>
        <div class="form-text text-body-secondary mt-2">
            <i class="fa-solid fa-circle-info me-1"></i>Si gastas más de esto, la barra de progreso se pondrá roja.
        </div>
    </div>
</form>