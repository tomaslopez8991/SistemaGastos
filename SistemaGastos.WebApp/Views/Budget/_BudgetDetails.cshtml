@model IEnumerable<dynamic>
@{
    Layout = null;
}

<div class="text-start mb-3">
    <h5 class="fw-bold text-primary mb-0">@ViewBag.CategoryName</h5>
    <small class="text-muted">Detalle de movimientos - @ViewBag.Period</small>
</div>

@if (!Model.Any())
{
    <div class="alert alert-secondary text-center">
        <i class="fa-solid fa-ghost fs-4 mb-2 d-block opacity-50"></i>
        No hay movimientos registrados aún.
    </div>
}
else
{
    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="sticky-top">
                <tr>
                    <th class="small text-muted text-uppercase">Fecha</th>
                    <th class="small text-muted text-uppercase">Descripción</th>
                    <th class="small text-muted text-uppercase text-end">Monto</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="font-size: 0.85rem;">@item.Date.ToString("dd/MM")</td>

                        <td>
                            <div class="fw-bold text-truncate" style="max-width: 180px;" title="@item.Description">
                                @item.Description
                            </div>
                            <span class="badge rounded-pill @(item.IsCard ? "bg-warning text-dark" : "bg-secondary")"
                                  style="font-size: 0.6rem; font-weight: normal;">
                                <i class="@(item.IsCard ? "fa-solid fa-credit-card" : "fa-solid fa-wallet") me-1"></i>
                                @item.Account
                            </span>
                        </td>

                        <td class="text-end fw-bold text-danger" style="font-size: 0.9rem;">
                            $ @item.Amount.ToString("N0")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}