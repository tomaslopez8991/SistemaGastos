@model List<SistemaGastos.Application.ViewModels.BudgetStatusViewModel>
@{
    ViewData["Title"] = "Presupuestos";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int m = ViewBag.CurrentMonth;
    int y = ViewBag.CurrentYear;

    var now = DateTime.Now;

    bool esMesActualOFuturo = (y > now.Year) || (y == now.Year && m > now.Month);
}
@Html.AntiForgeryToken()

<input type="hidden" id="currentMonth" value="@m" />
<input type="hidden" id="currentYear" value="@y" />

<div id="budget-container"
     data-url-create="@Url.Action("Save", "Budget")"
     data-url-delete="@Url.Action("Delete", "Budget")"
     data-url-copy="@Url.Action("CloneFromPreviousMonth", "Budget")"
     data-intro="Bienvenido al módulo de Presupuestos. Aquí defines límites de gasto por categoría y controlas en tiempo real cuánto llevas gastado. Es tu herramienta para no pasarte de tu plan financiero mensual."
     data-step="1">

    <div class="d-flex justify-content-between align-items-center mb-4"
         data-intro="Desde aquí puedes navegar entre meses y definir nuevos límites de gasto para controlar tus finanzas."
         data-step="2">
        <div>
            <h2 class="fw-bold mb-0"><i class="fa-solid fa-chart-pie text-warning me-2"></i>Presupuestos</h2>
            <p class="small mb-0">Controla tus límites de gasto</p>
        </div>

        <div class="d-flex align-items-center rounded-pill p-1 border border-secondary"
             data-intro="Usa estas flechas para moverte entre meses y ver o planificar tus presupuestos pasados y futuros. Solo puedes retroceder hasta el mes actual."
             data-step="3">

            @if (esMesActualOFuturo)
            {
                <a href="@Url.Action("Index", new { month = m == 1 ? 12 : m - 1, year = m == 1 ? y - 1 : y })"
                   class="btn btn-sm btn-dark rounded-circle">
                    <i class="fa-solid fa-chevron-left"></i>
                </a>
            }
            else
            {
                <button class="btn btn-sm btn-dark rounded-circle text-muted" disabled style="cursor: not-allowed; opacity: 0.5;">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
            }

            <span class="fw-bold mx-3" style="min-width: 120px; text-align: center;">@ViewBag.DateLabel</span>

            <a href="@Url.Action("Index", new { month = m == 12 ? 1 : m + 1, year = m == 12 ? y + 1 : y })"
               class="btn btn-sm btn-dark rounded-circle">
                <i class="fa-solid fa-chevron-right"></i>
            </a>
        </div>

        <button class="btn btn-warning shadow-sm fw-bold"
                onclick="abrirModalPresupuesto()"
                data-intro="Haz clic aquí para definir un nuevo límite de gasto en una categoría específica. Por ejemplo: 'Comida: $50.000', 'Entretenimiento: $20.000', etc."
                data-step="4">
            <i class="fa-solid fa-plus me-2"></i> Definir Límite
        </button>
    </div>

    @if (Model.Count > 0)
    {
        // 1. CÁLCULOS GLOBALES EN TIEMPO REAL
        decimal totalLimit = Model.Sum(x => x.Limit);
        decimal totalSpent = Model.Sum(x => x.Spent);
        decimal totalRemaining = totalLimit - totalSpent;

        // Porcentaje global (protegido contra división por cero)
        int totalPercentage = totalLimit == 0 ? 0 : (int)((totalSpent / totalLimit) * 100);
        int visualPercentage = totalPercentage > 100 ? 100 : totalPercentage;

        // Colores dinámicos (Semáforo)
        string statusColor = totalRemaining < 0 ? "bg-danger" : (totalPercentage >= 80 ? "bg-warning" : "bg-primary");
        string textColor = totalRemaining < 0 ? "text-danger" : "text-success";
        string icon = totalRemaining < 0 ? "fa-triangle-exclamation" : "fa-scale-balanced";

        <div class="card bg-opacity-75 border-secondary shadow-lg mb-4 overflow-hidden"
             data-intro="Este panel de control te muestra el resumen total del mes: cuánto planeaste gastar, cuánto gastaste realmente y cuánto te queda disponible. Los colores cambian según tu situación: verde (bien), amarillo (cuidado) o rojo (excedido)."
             data-step="5">
            <div class="card-body p-4">
                <div class="row align-items-center">

                    <div class="col-md-3 border-end border-secondary border-opacity-25 text-center d-none d-md-block"
                         data-intro="Indicador visual de tu situación financiera: si el ícono es verde con balanza, vas bien. Si es rojo con alerta, te excediste del presupuesto."
                         data-step="6">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle border border-secondary mb-2"
                             style="width: 60px; height: 60px;">
                            <i class="fa-solid @icon fs-3 @(totalRemaining < 0 ? "text-danger" : "text-primary")"></i>
                        </div>
                        <h6 class="fw-bold mb-0">Balance Mensual</h6>
                        <small class="text-muted">
                            @(totalRemaining < 0 ? "Presupuesto Excedido" : "Finanzas Saludables")
                        </small>
                    </div>

                    <div class="col-md-9">
                        <div class="row text-center mb-3"
                             data-intro="Aquí ves tres cifras clave: el límite total que definiste, cuánto gastaste hasta ahora y cuánto dinero te queda disponible en el mes."
                             data-step="7">
                            <div class="col-4">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Límite Total</small>
                                <h3 class="fw-bold mb-0">$ @totalLimit.ToString("N0")</h3>
                            </div>
                            <div class="col-4 border-start border-end border-secondary border-opacity-25">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Gastado Real</small>
                                <h3 class="@(totalSpent > totalLimit ? "text-danger" : "") fw-bold mb-0">
                                    $ @totalSpent.ToString("N0")
                                </h3>
                            </div>
                            <div class="col-4">
                                <small class="text-muted text-uppercase fw-bold" style="font-size: 0.7rem;">Disponible</small>
                                <h3 class="@textColor fw-bold mb-0">$ @totalRemaining.ToString("N0")</h3>
                            </div>
                        </div>

                        <div class="position-relative"
                             data-intro="Esta barra de progreso muestra visualmente qué porcentaje del presupuesto total has usado. Verde = bien, amarillo = cuidado, rojo = excedido."
                             data-step="8">
                            <div class="progress bg-secondary bg-opacity-25" style="height: 12px; border-radius: 6px;">
                                <div class="progress-bar @statusColor progress-bar-striped progress-bar-animated"
                                     role="progressbar"
                                     style="width: @visualPercentage%">
                                </div>
                            </div>
                            <div class="position-absolute top-0 start-50 translate-middle-x mt-3">
                                <span class="badge bg-secondary-subtle text-body border border-secondary rounded-pill">
                                    @totalPercentage% Utilizado
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @if (ViewBag.CurrentMonth == DateTime.Now.Month && ViewBag.CurrentYear == DateTime.Now.Year)
            {
                <div class="card-footer border-top border-secondary border-opacity-25 py-1 text-center"
                     data-intro="Si estás en el mes actual, verás cuántos días faltan para que cierre. Úsalo para calcular si tu ritmo de gasto es sostenible."
                     data-step="9">
                    <small style="font-size: 0.75rem;">
                        <i class="fa-solid fa-calendar-day me-1"></i>
                        Hoy es día @DateTime.Now.Day. Faltan @(DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month) - DateTime.Now.Day) días para cerrar el mes.
                    </small>
                </div>
            }
        </div>
    }

    <div class="row g-3"
         data-intro="Aquí verás una tarjeta por cada categoría con presupuesto. Cada una muestra el límite, lo gastado, lo disponible y alertas si vas muy rápido o te excediste."
         data-step="10">
        @if (Model.Count == 0)
        {
            <div class="col-12 text-center py-5"
                 data-intro="Si no tienes presupuestos definidos para este mes, puedes crear uno desde cero o copiar los límites del mes anterior para ahorrar tiempo."
                 data-step="11">
                <div class="opacity-50 mb-3">
                    <i class="fa-solid fa-piggy-bank fs-1"></i>
                </div>
                <h5 class="text-muted fw-bold">Tu hoja está en blanco este mes</h5>
                <p class="text-secondary small mb-4">No has definido límites para @ViewBag.DateLabel.</p>

                <div class="d-flex justify-content-center gap-3">
                    <button class="btn btn-outline-warning fw-bold"
                            onclick="abrirModalPresupuesto()"
                            data-intro="Crear presupuesto desde cero: define manualmente cada categoría y su límite."
                            data-step="12">
                        <i class="fa-solid fa-plus me-2"></i> Crear desde Cero
                    </button>

                    <button class="btn btn-primary fw-bold shadow-sm"
                            onclick="copiarMesAnterior()"
                            data-intro="Copiar del mes anterior: duplica todos los límites del mes pasado automáticamente. Muy útil si tus gastos son estables."
                            data-step="13">
                        <i class="fa-solid fa-copy me-2"></i> Copiar del Mes Anterior
                    </button>
                </div>
            </div>
        }
        else
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card bg-opacity-50 border-0 shadow-sm h-100 position-relative overflow-hidden"
                         data-intro="Cada tarjeta representa una categoría con presupuesto. La barra muestra el porcentaje consumido y cambia de color según tu situación. Haz clic en el monto gastado para ver el detalle de transacciones."
                         data-step="14">
                        <div class="position-absolute top-0 start-0 h-100" style="width: 4px; background-color: @item.CategoryColor;"></div>

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center"
                                         style="width: 35px; height: 35px; background-color: @item.CategoryColor; color: #fff;">
                                        <i class="@item.CategoryIcon"></i>
                                    </div>
                                    <h5 class="fw-bold mb-0">@item.CategoryName</h5>
                                </div>
                                <div class="dropdown"
                                     data-intro="Desde este menú puedes ver los movimientos que componen el gasto, editar el límite o eliminar este presupuesto."
                                     data-step="15">
                                    <button class="btn btn-link text-muted p-0" data-bs-toggle="dropdown"><i class="fa-solid fa-ellipsis-vertical"></i></button>
                                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" href="#" onclick="verDetallePresupuesto(@item.ID)">
                                                <i class="fa-solid fa-list-ul me-2 text-info"></i> Ver movimientos
                                            </a>
                                        </li>
                                        <li><a class="dropdown-item" href="#" onclick="abrirModalPresupuesto(@item.ID)"><i class="fa-solid fa-pen me-2"></i> Editar</a></li>
                                        <li><a class="dropdown-item text-danger" href="#" onclick="eliminarPresupuesto(@item.ID)"><i class="fa-solid fa-trash me-2"></i> Eliminar</a></li>
                                    </ul>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-end mt-3 mb-1">
                                <div onclick="verDetallePresupuesto(@item.ID)" style="cursor: pointer;" title="Ver detalle">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">GASTADO <i class="fa-solid fa-magnifying-glass ms-1" style="font-size: 10px;"></i></small>
                                    <span class="fw-bold fs-5 @item.TextColor">$ @item.Spent.ToString("N0")</span>
                                </div>
                                <div class="text-end">
                                    <small class="text-muted d-block" style="font-size: 0.75rem;">LÍMITE</small>
                                    <span class="fw-bold">$ @item.Limit.ToString("N0")</span>
                                </div>
                            </div>

                            <div class="progress bg-secondary bg-opacity-25" style="height: 10px; border-radius: 5px;">
                                <div class="progress-bar @item.StatusColor progress-bar-striped progress-bar-animated"
                                     role="progressbar"
                                     style="width: @item.PercentageVisual%">
                                </div>
                            </div>

                            <div class="mt-2 text-end">
                                @if (item.Remaining < 0)
                                {
                                    <small class="text-danger fw-bold"><i class="fa-solid fa-circle-exclamation me-1"></i>Excedido por $ @Math.Abs(item.Remaining).ToString("N0")</small>
                                }
                                else
                                {
                                    <small class="text-success"><i class="fa-solid fa-check me-1"></i>Disponibles: $ @item.Remaining.ToString("N0")</small>
                                }
                            </div>

                            @if (item.ShowPacingAlert)
                            {
                                <div class="alert alert-dark border-warning d-flex align-items-center p-2 mt-2 mb-0"
                                     role="alert"
                                     data-intro="Esta alerta inteligente te avisa si estás gastando muy rápido. Proyecta cuánto gastarás al final del mes según tu ritmo actual, ayudándote a frenar a tiempo."
                                     data-step="16">
                                    <div class="fs-4 text-warning me-3">
                                        <i class="fa-solid fa-person-running"></i>
                                    </div>
                                    <div style="line-height: 1.2;">
                                        <small class="text-warning fw-bold d-block text-uppercase" style="font-size: 0.65rem;">Cuidado con el ritmo</small>
                                        <small style="font-size: 0.75rem;">
                                            A este paso terminarás gastando <strong>$ @item.ProjectedAmount.ToString("N0")</strong>
                                            (+$@item.PacingDeviation.ToString("N0"))
                                        </small>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/Budget.js" asp-append-version="true"></script>
}
