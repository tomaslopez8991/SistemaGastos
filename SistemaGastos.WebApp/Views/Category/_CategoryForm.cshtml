@model SistemaGastos.Domain.Models.Category
@{
    Layout = null;
}

<form id="form-category">
    <input type="hidden" asp-for="ID" />

    <div class="row mb-3">
        <div class="col-md-8">
            <label asp-for="Name" class="form-label small fw-bold text-uppercase">Nombre</label>
            <input asp-for="Name" class="form-control" placeholder="Ej: Supermercado" required />
        </div>
        <div class="col-md-4">
            <label asp-for="Type" class="form-label small fw-bold text-uppercase">Tipo</label>
            <select asp-for="Type" class="form-select">
                <option value="Gasto">Gasto</option>
                <option value="Ingreso">Ingreso</option>
            </select>
        </div>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label small fw-bold text-uppercase">Descripción (Opcional)</label>
        <input asp-for="Description" class="form-control" placeholder="Breve detalle..." />
    </div>

    <div class="row align-items-end mb-3">
        <div class="col-3">
            <label asp-for="Color" class="form-label small fw-bold text-uppercase">Color</label>
            <input asp-for="Color" type="color" class="form-control form-control-color w-100" title="Elige un color" />
        </div>

        <div class="col-9">
            <label asp-for="Icon" class="form-label small fw-bold text-uppercase">Ícono (Clase FontAwesome)</label>
            <div class="input-group">
                <span class="input-group-text bg-body-tertiary"><i id="icon-preview" class="@Model.Icon"></i></span>
                <input asp-for="Icon" class="form-control" id="icon-input" placeholder="fa-solid fa-tag" />
            </div>
            <small class="text-muted" style="font-size: 0.75rem;">
                Busca íconos en <a href="https://fontawesome.com/search?m=free" target="_blank" class="text-decoration-none">FontAwesome</a>
            </small>
        </div>
    </div>
</form>

<script>
    // Script simple para actualizar la previsualización del ícono en tiempo real
    document.getElementById('icon-input').addEventListener('input', function() {
        document.getElementById('icon-preview').className = this.value;
    });
</script>