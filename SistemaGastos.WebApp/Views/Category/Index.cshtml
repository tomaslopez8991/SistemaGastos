@{
    ViewData["Title"] = "Categorías";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<div id="category-container"
     data-url-list="@Url.Action("GetCategoriesJson", "Category")"
     data-url-form="@Url.Action("GetCategoryForm", "Category")"
     data-url-save="@Url.Action("Save", "Category")"
     data-url-delete="@Url.Action("Delete", "Category")"
     data-intro="Bienvenido al módulo de Categorías. Aquí defines las etiquetas que usarás para organizar y clasificar todos tus ingresos y gastos. Ejemplos: Comida, Transporte, Salario, Freelance, etc."
     data-step="1">

    <div class="d-flex justify-content-between align-items-center mb-4"
         data-intro="Desde aquí puedes gestionar todas tus categorías para mantener ordenados tus movimientos financieros."
         data-step="2">
        <div>
            <h2 class="fw-bold mb-0">Categorías</h2>
            <p class="small">Organiza tus movimientos</p>
        </div>
        <button class="btn btn-success btn-lg shadow"
                onclick="abrirModalCategoria()"
                data-intro="Haz clic aquí para crear una nueva categoría. Podrás elegir un nombre, ícono, color y si es para Ingresos o Gastos."
                data-step="3">
            <i class="fa-solid fa-plus me-2"></i> Nueva
        </button>
    </div>

    <ul class="nav nav-pills mb-4 gap-2"
        id="pills-tab"
        role="tablist"
        data-intro="Usa estos filtros para ver solo las categorías que necesitas: todas juntas, solo las de gastos o solo las de ingresos."
        data-step="4">
        <li class="nav-item">
            <button class="nav-link active rounded-pill px-4"
                    onclick="filtrarCategorias('all')"
                    data-intro="Ver todas las categorías sin filtrar."
                    data-step="5">
                Todas
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4"
                    onclick="filtrarCategorias('Gasto')"
                    data-intro="Filtrar solo categorías de gastos: Comida, Transporte, Salud, Entretenimiento, etc."
                    data-step="6">
                Gastos
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4"
                    onclick="filtrarCategorias('Ingreso')"
                    data-intro="Filtrar solo categorías de ingresos: Salario, Freelance, Inversiones, Ventas, etc."
                    data-step="7">
                Ingresos
            </button>
        </li>
    </ul>

    <div class="row g-3"
         id="categories-grid"
         data-intro="Aquí aparecerán todas tus categorías en formato de tarjetas. Cada una muestra su ícono, nombre, color y tipo (Ingreso/Gasto). Puedes editarlas o eliminarlas desde el menú de cada tarjeta."
         data-step="8">
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Category.js" asp-append-version="true"></script>
}
