@{
    ViewData["Title"] = "Categorías";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<div id="category-container"
     class="category-page"
     data-url-list="@Url.Action("GetCategoriesJson", "Category")"
     data-url-form="@Url.Action("GetCategoryForm", "Category")"
     data-url-save="@Url.Action("Save", "Category")"
     data-url-delete="@Url.Action("Delete", "Category")">
    <header class="category-header">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="category-header-icon" aria-hidden="true"><i class="fa-solid fa-tags"></i></span>
                <h1 class="h3 fw-bold mb-0">Categorías</h1>
                <span id="category-total" class="badge text-bg-secondary">0</span>
            </div>
            <p class="text-body-secondary mb-0">Organizá ingresos y gastos para entender mejor tus movimientos.</p>
        </div>
        <button type="button" class="btn btn-primary category-new-button" id="new-category-button">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Nueva categoría</span>
        </button>
    </header>

    <section class="category-toolbar" aria-label="Filtros de categorías">
        <div class="category-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <label for="category-search" class="visually-hidden">Buscar categorías</label>
            <input id="category-search" type="search" class="form-control"
                   placeholder="Buscar por nombre o descripción" autocomplete="off" />
        </div>
        <div class="category-filter-group" role="group" aria-label="Filtrar por tipo">
            <button type="button" class="category-filter active" data-category-filter="all" aria-pressed="true">
                Todas <span id="count-all">0</span>
            </button>
            <button type="button" class="category-filter" data-category-filter="Gasto" aria-pressed="false">
                Gastos <span id="count-expense">0</span>
            </button>
            <button type="button" class="category-filter" data-category-filter="Ingreso" aria-pressed="false">
                Ingresos <span id="count-income">0</span>
            </button>
        </div>
    </section>

    <div id="category-feedback" class="visually-hidden" role="status" aria-live="polite"></div>
    <div id="categories-grid" class="category-grid" aria-busy="true"></div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/category.css" asp-append-version="true" />
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Category.js" asp-append-version="true"></script>
}
