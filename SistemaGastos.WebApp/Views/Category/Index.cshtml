@{
    ViewData["Title"] = "Categorías";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<div id="category-container"
     data-url-list="@Url.Action("GetCategoriesJson", "Category")"
     data-url-form="@Url.Action("GetCategoryForm", "Category")"
     data-url-save="@Url.Action("Save", "Category")"
     data-url-delete="@Url.Action("Delete", "Category")"
     data-intro="Las categorías clasifican tus ingresos y gastos. Ejemplos: Comida, Transporte, Salario, Freelance."
     data-step="1">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Categorías</h2>
            <p class="small">Organiza tus movimientos</p>
        </div>
        <button class="btn btn-success btn-lg shadow"
                onclick="abrirModalCategoria()"
                data-intro="Creá una nueva categoría desde acá. <span class='tut-action'>→ Tocá <strong>+ Nueva</strong>. Completá: <strong>Nombre</strong> (ej: Supermercado), <strong>Tipo</strong> (Gasto/Ingreso), <strong>Color</strong> y <strong>Ícono</strong> (clase FontAwesome, ej: fa-solid fa-cart-shopping). Luego Guardar.</span>"
                data-step="2">
            <i class="fa-solid fa-plus me-2"></i> Nueva
        </button>
    </div>

    <ul class="nav nav-pills mb-4 gap-2"
        id="pills-tab"
        role="tablist"
        data-intro="Filtrá por tipo. <span class='tut-action'>→ Tocá <strong>Gastos</strong> o <strong>Ingresos</strong> para ver solo las de esa categoría.</span>"
        data-step="3">
        <li class="nav-item">
            <button class="nav-link active rounded-pill px-4"
                    onclick="filtrarCategorias('all')">
                Todas
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4"
                    onclick="filtrarCategorias('Gasto')">
                Gastos
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link rounded-pill px-4"
                    onclick="filtrarCategorias('Ingreso')">
                Ingresos
            </button>
        </li>
    </ul>

    <div class="row g-3"
         id="categories-grid"
         data-intro="Cada tarjeta muestra ícono, nombre, color y tipo. Usá el menú ⋮ para editar o eliminar."
         data-step="4">
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Category.js" asp-append-version="true"></script>
}
