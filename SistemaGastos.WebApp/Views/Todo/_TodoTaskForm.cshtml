@model SistemaGastos.Domain.Models.TodoTask
@{
    Layout = null;
}

<form id="form-todo">
    <input type="hidden" asp-for="TaskId" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label fw-bold text-uppercase small">Título</label>
        <input asp-for="Title" class="form-control" placeholder="Ej: Pagar seguro auto..." required />
    </div>

    <div class="mb-3">
        <label asp-for="DueDate" class="form-label fw-bold text-uppercase small">Fecha Vencimiento</label>
        <input asp-for="DueDate" type="date" class="form-control" value="@(Model.DueDate.ToString("yyyy-MM-dd"))" required />
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label fw-bold text-uppercase small">Descripción / Notas</label>
        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Detalles adicionales..."></textarea>
    </div>
</form>