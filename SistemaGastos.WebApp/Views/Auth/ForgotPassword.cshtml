@model SistemaGastos.Domain.Models.Login
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Recuperar Contraseña";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.css" />
    <link rel="stylesheet" href="~/css/Login.css" asp-append-version="true" />
</head>
<body>

    <div class="position-absolute top-0 end-0 p-4" style="z-index: 1050;">
        <div class="dropdown">
            <button class="btn btn-glass-nav dropdown-toggle d-flex align-items-center gap-2" type="button" id="bd-theme" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fa-solid fa-circle-half-stroke"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2">
                <li><button class="dropdown-item d-flex align-items-center gap-2" data-bs-theme-value="light"><i class="fa-solid fa-sun opacity-50"></i> Light</button></li>
                <li><button class="dropdown-item d-flex align-items-center gap-2" data-bs-theme-value="dark"><i class="fa-solid fa-moon opacity-50"></i> Dark</button></li>
                <li><button class="dropdown-item d-flex align-items-center gap-2" data-bs-theme-value="auto"><i class="fa-solid fa-circle-half-stroke opacity-50"></i> Auto</button></li>
            </ul>
        </div>
    </div>

    <div class="container d-flex justify-content-center">
        <div class="card-glass" style="max-width: 400px;">

            <div class="text-center mb-4">
                <div class="mb-3">
                    <i class="fa-solid fa-envelope-open-text fa-3x text-info"></i>
                </div>
                <h3 class="fw-bold text-white">Recuperar Acceso</h3>
                <p class="text-white-50 small px-3">Ingresa tu correo electrónico y te enviaremos las instrucciones.</p>
            </div>

            <form asp-action="ForgotPassword" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small text-center mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label text-white-50 small fw-bold">EMAIL REGISTRADO</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="fa-solid fa-at"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="ejemplo@correo.com" required autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="d-grid gap-2 mb-4">
                    <button type="submit" class="btn btn-primary-glow shadow-sm">
                        ENVIAR INSTRUCCIONES <i class="fa-solid fa-paper-plane ms-2"></i>
                    </button>
                </div>

                <div class="text-center">
                    <a href="/Auth" class="link-secondary text-decoration-none">
                        <i class="fa-solid fa-arrow-left me-1"></i> Volver al inicio
                    </a>
                </div>
            </form>

            @if (ViewBag.errorLogin != null)
            {
                <div class="alert alert-danger mt-3 mb-0 py-2 small text-center border-0 bg-danger bg-opacity-25 text-danger">
                    <i class="fa-solid fa-circle-xmark me-1"></i> @ViewBag.errorLogin
                </div>
            }
            @if (ViewBag.successLogin != null)
            {
                <div class="alert alert-success mt-3 mb-0 py-2 small text-center border-0 bg-success bg-opacity-25 text-success">
                    <i class="fa-solid fa-envelope-circle-check me-1"></i> @ViewBag.successLogin
                </div>
            }

        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/color-modes.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
</body>
</html>