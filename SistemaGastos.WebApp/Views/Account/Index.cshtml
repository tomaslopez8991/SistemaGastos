@model IEnumerable<SistemaGastos.Domain.Models.Account>
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Cuentas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    // Inicializar diccionario para almacenar totales por moneda
    var currencyTotals = new Dictionary<string, decimal>();
}

<div id="accounts-container"
     data-url-list="@Url.Action("GetAll", "Account")"
     data-url-totals="@Url.Action("GetAccountTotals", "Account")"
     data-url-create="@Url.Action("Create", "Account")"
     data-url-edit="@Url.Action("Edit", "Account")"
     data-url-delete="@Url.Action("Delete", "Account")"
     data-url-transfer="@Url.Action("ProcessTransfer", "Account")"
     data-intro="Administrá tus cuentas bancarias, efectivo y más desde acá."
     data-step="1">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">Mi Billetera</h2>
            <p class="small">Gestiona tus saldos y liquidez</p>
        </div>
        <button class="btn btn-success btn-lg shadow-lg"
                onclick="abrirModalCuenta()"
                data-intro="Agregá una nueva cuenta desde acá. <span class='tut-action'>→ Tocá <strong>+ Nueva Cuenta</strong>. Completá: <strong>Nombre</strong> (ej: Santander Débito), <strong>Tipo</strong> (Banco/Efectivo/Billetera Virtual), <strong>Moneda</strong> (ARS/USD) y <strong>Saldo actual</strong>. Luego Guardar.</span>"
                data-step="2">
            <i class="fa-solid fa-plus me-2"></i> Nueva Cuenta
        </button>
    </div>

    <div class="row g-3 mb-5"
         id="totals-wrapper"
         data-intro="Saldo total consolidado por moneda (ARS, USD, etc.). Suma todas tus cuentas de cada divisa."
         data-step="3">
    </div>

    <div class="row g-4"
         id="accounts-grid"
         data-intro="Cada tarjeta muestra el saldo actual de la cuenta. Usá ✏ para editar, 🗑 para eliminar o el ícono de transferencia para mover fondos entre cuentas."
         data-step="4">
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Account.js" asp-append-version="true"></script>
}
