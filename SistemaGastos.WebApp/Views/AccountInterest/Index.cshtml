@model SistemaGastos.Application.Features.AccountInterest.Queries.AccountInterestPageDto
@{
    ViewData["Title"] = "Intereses de cuentas";
    var culture = new System.Globalization.CultureInfo("es-AR");
}

<div class="container-fluid px-4 py-3">

    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h4 class="mb-0 fw-semibold">Intereses de cuentas</h4>
            <small class="text-muted">Configuración y seguimiento de intereses por descubierto</small>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary btn-sm" onclick="recalculate()">
                <i class="fa-solid fa-rotate me-1"></i>Recalcular
            </button>
            @if (Model.AvailableAccounts.Any())
            {
                <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#modalAddSetting">
                    <i class="fa-solid fa-plus me-1"></i>Agregar cuenta
                </button>
            }
        </div>
    </div>

    <!-- Stat cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="tx-stat-card">
                <div class="tx-stat-label">Cuentas configuradas</div>
                <div class="tx-stat-value">@Model.Settings.Count</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tx-stat-card">
                <div class="tx-stat-label">Activas</div>
                <div class="tx-stat-value">@Model.Settings.Count(s => s.Enabled)</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tx-stat-card">
                <div class="tx-stat-label">Interés acumulado total</div>
                <div class="tx-stat-value text-danger">
                    @Model.Settings.Sum(s => s.CumulativeInterest).ToString("C", culture)
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="tx-stat-card">
                <div class="tx-stat-label">Último log</div>
                <div class="tx-stat-value" style="font-size:15px">
                    @(Model.RecentLogs.FirstOrDefault()?.Date.ToString("dd/MM/yyyy") ?? "—")
                </div>
            </div>
        </div>
    </div>

    <!-- Cuentas configuradas -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-transparent border-0 pt-3 pb-2">
            <h6 class="mb-0 fw-semibold"><i class="fa-solid fa-sliders me-2 text-primary"></i>Cuentas con interés configurado</h6>
        </div>
        <div class="card-body p-0">
            @if (!Model.Settings.Any())
            {
                <div class="text-center text-muted py-4">
                    <i class="fa-solid fa-circle-info fa-2x mb-2 d-block"></i>
                    No hay cuentas configuradas. Agregá una para empezar.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cuenta</th>
                                <th>Tasa anual</th>
                                <th>Interés acumulado</th>
                                <th>Último log</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model.Settings)
                            {
                                <tr>
                                    <td>
                                        <span class="fw-medium">@s.AccountName</span>
                                        <small class="text-muted ms-1">@s.AccountCurrency</small>
                                    </td>
                                    <td>@((s.InterestRate * 100).ToString("N2"))%</td>
                                    <td class="text-danger fw-medium">@s.CumulativeInterest.ToString("C", culture)</td>
                                    <td>@(s.LastLogDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td>
                                        @if (s.Enabled)
                                        {
                                            <span class="badge bg-success-subtle text-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <div class="d-flex gap-1 justify-content-end">
                                            <button class="btn btn-sm btn-outline-secondary"
                                                    onclick="editSetting(@s.ID, @s.AccountID, @s.InterestRate.ToString("F4", System.Globalization.CultureInfo.InvariantCulture), @s.Enabled.ToString().ToLower())"
                                                    title="Editar">
                                                <i class="fa-solid fa-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm @(s.Enabled ? "btn-outline-warning" : "btn-outline-success")"
                                                    onclick="toggleSetting(@s.ID)"
                                                    title="@(s.Enabled ? "Desactivar" : "Activar")">
                                                <i class="fa-solid @(s.Enabled ? "fa-pause" : "fa-play")"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger"
                                                    onclick="deleteSetting(@s.ID, '@s.AccountName')"
                                                    title="Eliminar">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Historial diario y cargos mensuales -->
    <div class="row g-3">

        <!-- Log diario (últimos 30 días) -->
        <div class="col-12 col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-3 pb-2">
                    <h6 class="mb-0 fw-semibold"><i class="fa-solid fa-calendar-days me-2 text-info"></i>Log diario (últimos 30 días)</h6>
                </div>
                <div class="card-body p-0">
                    @if (!Model.RecentLogs.Any())
                    {
                        <div class="text-center text-muted py-4">Sin registros aún.</div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height:400px;overflow-y:auto">
                            <table class="table table-sm mb-0 align-middle">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Fecha</th>
                                        <th class="text-end">Saldo</th>
                                        <th class="text-end">Días consec.</th>
                                        <th class="text-end">Interés día</th>
                                        <th class="text-end">Acumulado</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var log in Model.RecentLogs)
                                    {
                                        <tr class="@(log.Balance < 0 ? "table-danger" : "")">
                                            <td>@log.Date.ToString("dd/MM/yyyy")</td>
                                            <td class="text-end @(log.Balance < 0 ? "text-danger" : "text-success")">
                                                @log.Balance.ToString("C", culture)
                                            </td>
                                            <td class="text-end">@log.DayCounter</td>
                                            <td class="text-end text-danger">
                                                @(log.DailyInterest > 0 ? log.DailyInterest.ToString("C", culture) : "—")
                                            </td>
                                            <td class="text-end text-danger fw-medium">@log.CumulativeInterest.ToString("C", culture)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Cargos mensuales -->
        <div class="col-12 col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-transparent border-0 pt-3 pb-2">
                    <h6 class="mb-0 fw-semibold"><i class="fa-solid fa-file-invoice-dollar me-2 text-warning"></i>Cargos mensuales</h6>
                </div>
                <div class="card-body p-0">
                    @if (!Model.MonthlyCharges.Any())
                    {
                        <div class="text-center text-muted py-4">Sin cargos generados aún.</div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height:400px;overflow-y:auto">
                            <table class="table table-sm mb-0 align-middle">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Período</th>
                                        <th class="text-end">Total interés</th>
                                        <th class="text-center">Transacción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var charge in Model.MonthlyCharges)
                                    {
                                        var periodo = new DateTime(charge.Year, charge.Month, 1).ToString("MMMM yyyy", culture);
                                        <tr>
                                            <td class="text-capitalize">@periodo</td>
                                            <td class="text-end text-danger fw-medium">@charge.TotalInterest.ToString("C", culture)</td>
                                            <td class="text-center">
                                                @if (charge.TransactionID.HasValue)
                                                {
                                                    <span class="badge bg-success-subtle text-success">Cobrado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary-subtle text-secondary">$0</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal agregar/editar -->
<div class="modal fade" id="modalAddSetting" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h6 class="modal-title fw-semibold" id="modalSettingTitle">Agregar cuenta con interés</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="settingID" value="">
                <div class="mb-3" id="accountSelectWrapper">
                    <label class="form-label fw-medium">Cuenta</label>
                    <select class="form-select" id="accountID">
                        @foreach (var a in Model.AvailableAccounts)
                        {
                            <option value="@a.ID">@a.Name (@a.Currency)</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-medium">Tasa anual (ej: 1.55 = 155%)</label>
                    <div class="input-group">
                        <input type="number" class="form-control" id="interestRate" step="0.01" min="0" max="99" value="1.55">
                        <span class="input-group-text">× 100%</span>
                    </div>
                    <div class="form-text">Ingresá 1.55 para una TNA del 155%</div>
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="settingEnabled" checked>
                    <label class="form-check-label" for="settingEnabled">Habilitado</label>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary btn-sm" onclick="saveSetting()">Guardar</button>
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<script src="~/js/AccountInterest.js" asp-append-version="true"></script>
}
