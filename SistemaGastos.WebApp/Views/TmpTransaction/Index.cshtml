@{
    ViewData["Title"] = "Proyección de gastos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<div id="planning-container"
     class="fin-dashboard"
     data-url-list="@Url.Action("GetTransactionsByMonth", "TmpTransaction")"
     data-url-form="@Url.Action("GetTmpTransactionForm", "TmpTransaction")"
     data-url-create="@Url.Action("Create", "TmpTransaction")"
     data-url-delete="@Url.Action("Delete", "TmpTransaction")"
     data-url-balances="@Url.Action("GetBalances", "TmpTransaction")"
     data-url-debt-snapshot="@Url.Action("GetDebtSnapshot", "TmpTransaction")"
     data-url-debt-advice="@Url.Action("GetDebtAdvice", "TmpTransaction")"
     data-url-daily-balances="@Url.Action("GetDailyBalances", "TmpTransaction")"
     data-url-earliest-pending="@Url.Action("GetEarliestPendingMonth", "TmpTransaction")"
     data-url-confirm-day="@Url.Action("ConfirmDay", "TmpTransaction")"
     data-url-fixed-list="@Url.Action("GetList", "FixedExpense")"
     data-url-fixed-form="@Url.Action("GetForm", "FixedExpense")"
     data-url-fixed-save="@Url.Action("Save", "FixedExpense")"
     data-url-fixed-pay="@Url.Action("PayNow", "FixedExpense")"
     data-url-fixed-delete="@Url.Action("Delete", "FixedExpense")"
     data-url-fixed-toggle="@Url.Action("ToggleActive", "FixedExpense")"
     data-url-fixed-pause="@Url.Action("TogglePause", "FixedExpense")"
     data-url-fixed-sync-cc="@Url.Action("SyncCreditCard", "FixedExpense")"
     data-url-income-list="@Url.Action("GetList", "FixedIncome")"
     data-url-income-form="@Url.Action("GetForm", "FixedIncome")"
     data-url-income-save="@Url.Action("Save", "FixedIncome")"
     data-url-income-receive="@Url.Action("ReceiveNow", "FixedIncome")"
     data-url-income-delete="@Url.Action("Delete", "FixedIncome")"
     data-url-income-toggle="@Url.Action("ToggleActive", "FixedIncome")"
     data-url-income-pause="@Url.Action("TogglePause", "FixedIncome")"
     data-url-set-day-override="@Url.Action("SetDayOverride", "TmpTransaction")"
     data-url-budget-list="@Url.Action("GetBudgetTab", "Budget")"
     data-url-budget-form="@Url.Action("GetBudgetForm", "Budget")"
     data-url-budget-save="@Url.Action("Save", "Budget")"
     data-url-budget-delete="@Url.Action("Delete", "Budget")"
     data-url-budget-copy="@Url.Action("CloneFromPreviousMonth", "Budget")"
     data-url-person-accounts="@Url.Action("GetAccounts", "Person")"
     data-url-person-list="@Url.Action("GetList", "Person")"
     data-url-person-save="@Url.Action("Save", "Person")"
     data-url-person-delete="@Url.Action("Delete", "Person")"
     data-url-person-payment-accounts="@Url.Action("GetPaymentAccounts", "Person")"
     data-url-person-register-payment="@Url.Action("RegisterPayment", "Person")"
     data-url-pay-tc="@Url.Action("PayCreditCard", "Account")"
     data-intro="Proyectá tu liquidez futura mes a mes. Acá planificás ingresos, gastos y ves cuánto dinero vas a tener."
     data-step="1">

    @* ── Header ───────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="fw-semibold mb-0" style="font-size:22px;">
                <i class="fa-solid fa-timeline text-primary me-2"></i>Proyección de gastos
            </h2>
            <p class="text-muted mb-0" style="font-size:13px;">Línea de tiempo de liquidez y compromisos mensuales</p>
        </div>
        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle d-flex align-items-center gap-2"
                    type="button"
                    id="btnCrearDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    data-intro="Agregá elementos al módulo de proyección. <span class='tut-action'>→ Tocá <strong>+ Nuevo</strong> y elegí: <strong>Transacción planificada</strong> (un gasto/ingreso puntual), <strong>Gasto fijo</strong> (recurrente mensual), <strong>Ingreso fijo</strong> o <strong>Presupuesto</strong> (límite por categoría).</span>"
                    data-step="2">
                <i class="fas fa-plus"></i>Nuevo
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="btnCrearDropdown">
                <li>
                    <a class="dropdown-item py-2" href="#" id="btnCrearPlanificado">
                        <i class="fa-solid fa-calendar-day text-primary me-2"></i>Transacción planificada
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="#" id="btnNewExpense">
                        <i class="fa-solid fa-repeat text-warning me-2"></i>Gasto fijo
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="#" id="btnNewIncome">
                        <i class="fa-solid fa-arrow-trend-up text-success me-2"></i>Ingreso fijo
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="#" id="btnNewBudget">
                        <i class="fa-solid fa-chart-pie text-info me-2"></i>Presupuesto
                    </a>
                </li>
            </ul>
        </div>
    </div>

    @* ── Carrusel slim de meses ───────────────────────────── *@
    <div class="month-carousel-wrapper position-relative mb-3"
         data-intro="Navegá entre meses con las flechas. El mes resaltado es el activo. <span class='tut-action'>→ Hacé clic en otro mes para ver su proyección.</span>"
         data-step="3">
        <button class="carousel-nav-btn carousel-nav-prev text-body" id="carouselPrev" style="display:none;">
            <i class="fas fa-chevron-left"></i>
        </button>
        <div class="month-carousel" id="monthCarousel">
            <div class="text-center w-100 text-body-secondary py-2">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span class="ms-2 small">Cargando proyección...</span>
            </div>
        </div>
        <button class="carousel-nav-btn carousel-nav-next text-body" id="carouselNext" style="display:none;">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>

    @* ── Barra info compacta del mes ──────────────────────── *@
    <div id="month-info-bar" class="month-info-bar mb-3" style="display:none;"
         data-intro="Ingresos, gastos y saldo neto del mes seleccionado de un vistazo."
         data-step="4">
        <span class="month-info-item">
            <i class="fa-solid fa-arrow-trend-up text-success me-1"></i>
            <span class="month-info-label">Ingresos</span>
            <span class="month-info-value text-success fw-semibold" id="infobar-income">$ —</span>
        </span>
        <span class="month-info-sep"></span>
        <span class="month-info-item">
            <i class="fa-solid fa-arrow-trend-down text-danger me-1"></i>
            <span class="month-info-label">Gastos</span>
            <span class="month-info-value text-danger fw-semibold" id="infobar-expense">$ —</span>
        </span>
        <span class="month-info-sep"></span>
        <span class="month-info-item">
            <i class="fa-solid fa-wallet me-1 text-primary"></i>
            <span class="month-info-label">Saldo neto</span>
            <span class="month-info-value fw-semibold" id="infobar-balance">$ —</span>
        </span>
    </div>

    @* ── Card con tabs ────────────────────────────────────── *@
    <div class="tx-table-card mb-4"
         data-intro="Cuatro pestañas: Movimientos planificados, Gastos fijos, Ingresos fijos y Presupuestos. <span class='tut-action'>→ Tocá cada pestaña para ver y gestionar esa sección.</span>"
         data-step="5">
        <div class="tmp-tabs-header">
            <ul class="nav nav-tabs border-bottom-0" id="cashflowTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active tmp-tab-btn"
                            id="planificados-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#planificados"
                            type="button" role="tab">
                        <i class="fa-solid fa-calendar-days me-2 text-primary"></i>Movimientos
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link tmp-tab-btn"
                            id="fijos-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#fijos"
                            type="button" role="tab">
                        <i class="fa-solid fa-repeat me-2 text-warning"></i>Gastos fijos
                        <span class="badge rounded-pill ms-1 tmp-badge-warning" id="badge-pending-fixed">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link tmp-tab-btn"
                            id="ingresos-fijos-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#ingresos-fijos"
                            type="button" role="tab">
                        <i class="fa-solid fa-arrow-trend-up me-2 text-success"></i>Ingresos fijos
                        <span class="badge rounded-pill ms-1 tmp-badge-success" id="badge-pending-income">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link tmp-tab-btn"
                            id="presupuestos-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#presupuestos"
                            type="button" role="tab">
                        <i class="fa-solid fa-chart-pie me-2 text-info"></i>Presupuestos
                        <span class="badge rounded-pill ms-1 bg-info bg-opacity-25 text-info" id="badge-presupuestos" style="display:none;">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link tmp-tab-btn"
                            id="deudas-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#deudas"
                            type="button" role="tab">
                        <i class="fa-solid fa-scale-balanced me-2 text-danger"></i>Deudas
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link tmp-tab-btn"
                            id="cuentas-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#cuentas"
                            type="button" role="tab">
                        <i class="fa-solid fa-people-group me-2 text-success"></i>Cuentas
                        <span class="badge rounded-pill ms-1 bg-success bg-opacity-25 text-success" id="badge-cuentas" style="display:none;">0</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="cashflowTabsContent">

            @* Tab: Movimientos → calendario inline *@
            <div class="tab-pane fade show active p-3" id="planificados" role="tabpanel">
                <div class="cf-calendar-legend d-flex flex-wrap gap-3 mb-3">
                    <span class="cf-legend-item"><span class="cf-legend-dot cf-evt-income"></span>Ingreso</span>
                    <span class="cf-legend-item"><span class="cf-legend-dot cf-evt-expense"></span>Gasto fijo / planificado</span>
                    <span class="cf-legend-item"><span class="cf-legend-dot cf-evt-tc"></span>Tarjeta de crédito</span>
                    <span class="cf-legend-item"><span class="cf-legend-dot cf-evt-personas"></span>Personas (a cobrar)</span>
                </div>
                <div id="financialCalendar"></div>
            </div>

            @* Tab: Gastos fijos *@
            <div class="tab-pane fade p-4" id="fijos" role="tabpanel">
                <div id="expenses-grid" class="row g-3">
                    <div class="col-12 text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="ms-2 small">Cargando compromisos...</span>
                    </div>
                </div>
            </div>

            @* Tab: Ingresos Fijos *@
            <div class="tab-pane fade p-4" id="ingresos-fijos" role="tabpanel">
                <div id="incomes-grid" class="row g-3">
                    <div class="col-12 text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                        <span class="ms-2 small">Cargando ingresos fijos...</span>
                    </div>
                </div>
            </div>

            @* Tab: Presupuestos *@
            <div class="tab-pane fade p-4" id="presupuestos" role="tabpanel">
                <div id="budgets-grid" class="row g-4">
                    <div class="col-12 text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-info" role="status"></div>
                        <span class="ms-2 small">Cargando presupuestos...</span>
                    </div>
                </div>
            </div>

            @* Tab: Deudas (snapshot para aplanar deudas) *@
            <div class="tab-pane fade p-4" id="deudas" role="tabpanel">
                <div id="debt-snapshot-summary" class="row g-3 mb-4">
                    <div class="col-12 text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-danger" role="status"></div>
                        <span class="ms-2 small">Calculando snapshot de deudas...</span>
                    </div>
                </div>
                <div id="debt-snapshot-cards" class="row g-3 mb-4"></div>

                <div class="card fin-card border-0" id="debt-advice-card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-semibold mb-0">
                                <i class="fa-solid fa-wand-magic-sparkles text-primary me-2"></i>Recomendación con IA
                            </h5>
                            <button class="btn btn-sm btn-outline-primary" id="btnGenerateDebtAdvice">
                                <i class="fa-solid fa-sparkles me-1"></i>Generar recomendación
                            </button>
                        </div>
                        <div id="debt-advice-content" class="text-muted small mb-3">
                            Tocá "Generar recomendación" para que la IA sugiera qué pagos adelantar en base al snapshot de arriba, o escribí tu propia pregunta abajo.
                        </div>
                        <div class="input-group">
                            <input type="text"
                                   class="form-control"
                                   id="debtAdviceQuestion"
                                   placeholder="Ej: ¿me conviene adelantar el pago de la tarjeta Visa este mes?"
                                   maxlength="500">
                            <button class="btn btn-primary" id="btnAskDebtAdvice">
                                <i class="fa-solid fa-paper-plane me-1"></i>Preguntar
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            @* Tab: Cuentas por persona *@
            <div class="tab-pane fade p-4" id="cuentas" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <p class="text-muted small mb-0">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Saldo acumulado que cada persona te debe por gastos atribuidos.
                    </p>
                    <a href="@Url.Action("Index", "Person")" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-users-gear me-1"></i>Administrar personas
                    </a>
                </div>
                <div id="person-accounts-grid" class="row g-3">
                    <div class="col-12 text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                        <span class="ms-2 small">Calculando cuentas...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@* ── Panel lateral de detalle de día ─────────────────────── *@
<div id="cf-day-panel" class="cf-day-panel fin-dashboard">
    <div class="cf-day-panel-header">
        <div>
            <div class="fw-semibold" id="cf-panel-date-label"></div>
            <small id="cf-panel-balance-label" class="text-body-secondary"></small>
        </div>
        <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-primary d-flex align-items-center gap-1" id="cf-panel-add-btn">
                <i class="fas fa-plus"></i><span>Agregar</span>
            </button>
            <button type="button" class="btn-close" id="cf-panel-close-btn" aria-label="Cerrar"></button>
        </div>
    </div>
    <div class="cf-day-panel-body" id="cf-panel-body">
        <p class="text-body-secondary small">Sin movimientos para este día.</p>
    </div>
</div>
<div id="cf-panel-overlay" class="cf-panel-overlay"></div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/DistributionPanel.js" asp-append-version="true"></script>
    <script src="~/js/TmpTransaction.js" asp-append-version="true"></script>
    <script src="~/js/FixedExpense.js" asp-append-version="true"></script>
    <script src="~/js/FixedIncome.js" asp-append-version="true"></script>
    <script src="~/js/Budget.js" asp-append-version="true"></script>
    <script src="~/js/PersonAccounts.js" asp-append-version="true"></script>
    <script src="~/js/CashflowCalendar.js" asp-append-version="true"></script>
    <script src="~/js/DebtSnapshot.js" asp-append-version="true"></script>
}
