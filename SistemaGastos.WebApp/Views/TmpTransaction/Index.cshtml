@{
    ViewData["Title"] = "Proyección de gastos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<div id="planning-container"
     data-url-list="@Url.Action("GetTransactionsByMonth", "TmpTransaction")"
     data-url-form="@Url.Action("GetTmpTransactionForm", "TmpTransaction")"
     data-url-create="@Url.Action("Create", "TmpTransaction")"
     data-url-delete="@Url.Action("Delete", "TmpTransaction")"
     data-url-balances="@Url.Action("GetBalances", "TmpTransaction")"
     data-url-confirm="@Url.Action("Confirm", "TmpTransaction")"
     data-url-fixed-list="@Url.Action("GetList", "FixedExpense")"
     data-url-fixed-form="@Url.Action("GetForm", "FixedExpense")"
     data-url-fixed-save="@Url.Action("Save", "FixedExpense")"
     data-url-fixed-pay="@Url.Action("PayNow", "FixedExpense")"
     data-url-fixed-delete="@Url.Action("Delete", "FixedExpense")"
     data-url-fixed-toggle="@Url.Action("ToggleActive", "FixedExpense")"
     data-url-income-list="@Url.Action("GetList", "FixedIncome")"
     data-url-income-form="@Url.Action("GetForm", "FixedIncome")"
     data-url-income-save="@Url.Action("Save", "FixedIncome")"
     data-url-income-receive="@Url.Action("ReceiveNow", "FixedIncome")"
     data-url-income-delete="@Url.Action("Delete", "FixedIncome")"
     data-url-income-toggle="@Url.Action("ToggleActive", "FixedIncome")"
     data-url-budget-list="@Url.Action("GetBudgetTab", "Budget")"
     data-url-budget-form="@Url.Action("GetBudgetForm", "Budget")"
     data-url-budget-save="@Url.Action("Save", "Budget")"
     data-url-budget-delete="@Url.Action("Delete", "Budget")"
     data-url-budget-copy="@Url.Action("CloneFromPreviousMonth", "Budget")"
     data-url-person-accounts="@Url.Action("GetAccounts", "Person")"
     data-url-person-list="@Url.Action("GetList", "Person")"
     data-url-person-save="@Url.Action("Save", "Person")"
     data-url-person-delete="@Url.Action("Delete", "Person")"
     data-url-person-payment-accounts="@Url.Action("GetPaymentAccounts", "Person")"
     data-url-person-register-payment="@Url.Action("RegisterPayment", "Person")"
     data-intro="Bienvenido al módulo de Cashflow Pro. Aquí proyectás tu liquidez futura y administrás tus gastos recurrentes en un solo lugar."
     data-step="1">

    @* ── Header ───────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="fw-semibold mb-0" style="font-size:22px;">
                <i class="fa-solid fa-timeline text-primary me-2"></i>Proyección de gastos
            </h2>
            <p class="text-muted mb-0" style="font-size:13px;">Línea de tiempo de liquidez y compromisos mensuales</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="@Url.Action("PlanMetas", "TmpTransaction")" class="btn btn-outline-success d-flex align-items-center gap-2">
                <i class="fa-solid fa-bullseye"></i>Plan de Metas
            </a>
        <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle d-flex align-items-center gap-2"
                    type="button"
                    id="btnCrearDropdown"
                    data-bs-toggle="dropdown"
                    aria-expanded="false">
                <i class="fas fa-plus"></i>Nuevo
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="btnCrearDropdown">
                <li>
                    <a class="dropdown-item py-2" href="#" id="btnCrearPlanificado">
                        <i class="fa-solid fa-calendar-day text-primary me-2"></i>Transacción planificada
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="#" id="btnNewExpense">
                        <i class="fa-solid fa-repeat text-warning me-2"></i>Gasto fijo
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="#" id="btnNewIncome">
                        <i class="fa-solid fa-arrow-trend-up text-success me-2"></i>Ingreso fijo
                    </a>
                </li>
                <li>
                    <a class="dropdown-item py-2" href="#" id="btnNewBudget">
                        <i class="fa-solid fa-chart-pie text-info me-2"></i>Presupuesto
                    </a>
                </li>
            </ul>
        </div>
        </div>
    </div>

    @* ── Carrusel de meses ────────────────────────────────── *@
    <div class="month-carousel-wrapper position-relative mb-4">
        <button class="carousel-nav-btn carousel-nav-prev text-body" id="carouselPrev" style="display:none;">
            <i class="fas fa-chevron-left"></i>
        </button>
        <div class="month-carousel" id="monthCarousel">
            <div class="text-center w-100 text-body-secondary py-3">
                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                <span class="ms-2">Cargando proyección...</span>
            </div>
        </div>
        <button class="carousel-nav-btn carousel-nav-next text-body" id="carouselNext" style="display:none;">
            <i class="fas fa-chevron-right"></i>
        </button>
    </div>

    @* ── Dashboard de mes ─────────────────────────────────── *@
    <div class="row g-3 mb-4" id="month-dashboard" style="display:none;">
        <div class="col-md-3 col-lg">
            <div class="tmp-dash-card income clickable" id="dash-income-card" data-breakdown="income">
                <div>
                    <div class="tmp-dash-label">Ingresos proyectados</div>
                    <div class="tmp-dash-value" id="dash-income">$ —</div>
                    <div class="tmp-dash-detail-hint"><i class="fa-regular fa-eye"></i>Ver detalle</div>
                </div>
                <i class="fa-solid fa-arrow-trend-up tmp-dash-icon"></i>
            </div>
        </div>
        <div class="col-md-3 col-lg">
            <div class="tmp-dash-card expense clickable" id="dash-expense-card" data-breakdown="expense">
                <div>
                    <div class="tmp-dash-label">Gastos proyectados</div>
                    <div class="tmp-dash-value" id="dash-expense">$ —</div>
                    <div class="tmp-dash-detail-hint"><i class="fa-regular fa-eye"></i>Ver detalle</div>
                </div>
                <i class="fa-solid fa-arrow-trend-down tmp-dash-icon"></i>
            </div>
        </div>
        <div class="col-md-3 col-lg">
            <div class="tmp-dash-card balance">
                <div>
                    <div class="tmp-dash-label">Saldo proyectado</div>
                    <div class="tmp-dash-value balance-val" id="dash-balance">$ —</div>
                </div>
                <i class="fa-solid fa-wallet tmp-dash-icon"></i>
            </div>
        </div>
    </div>

    @* ── Card con tabs ────────────────────────────────────── *@
    <div class="tx-table-card mb-4">
        <div class="tmp-tabs-header">
            <ul class="nav nav-tabs border-bottom-0" id="cashflowTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active tmp-tab-btn"
                            id="planificados-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#planificados"
                            type="button" role="tab">
                        <i class="fa-solid fa-calendar-day me-2 text-primary"></i>Movimientos
                        <span class="badge rounded-pill ms-1 bg-primary bg-opacity-25 text-primary" id="badge-movimientos" style="display:none;">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link tmp-tab-btn"
                            id="fijos-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#fijos"
                            type="button" role="tab">
                        <i class="fa-solid fa-repeat me-2 text-warning"></i>Gastos fijos
                        <span class="badge rounded-pill ms-1 tmp-badge-warning" id="badge-pending-fixed">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link tmp-tab-btn"
                            id="ingresos-fijos-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#ingresos-fijos"
                            type="button" role="tab">
                        <i class="fa-solid fa-arrow-trend-up me-2 text-success"></i>Ingresos fijos
                        <span class="badge rounded-pill ms-1 tmp-badge-success" id="badge-pending-income">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link tmp-tab-btn"
                            id="presupuestos-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#presupuestos"
                            type="button" role="tab">
                        <i class="fa-solid fa-chart-pie me-2 text-info"></i>Presupuestos
                        <span class="badge rounded-pill ms-1 bg-info bg-opacity-25 text-info" id="badge-presupuestos" style="display:none;">0</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link tmp-tab-btn"
                            id="cuentas-tab"
                            data-bs-toggle="tab"
                            data-bs-target="#cuentas"
                            type="button" role="tab">
                        <i class="fa-solid fa-people-group me-2 text-success"></i>Cuentas
                        <span class="badge rounded-pill ms-1 bg-success bg-opacity-25 text-success" id="badge-cuentas" style="display:none;">0</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="tab-content" id="cashflowTabsContent">

            @* Tab: Movimientos planificados *@
            <div class="tab-pane fade show active p-4" id="planificados" role="tabpanel">
                <div class="d-flex justify-content-end mb-3">
                    <button class="btn btn-outline-danger btn-sm btn-borrar-masivo d-flex align-items-center gap-2" disabled>
                        <i class="fas fa-trash"></i>Borrar seleccionados
                    </button>
                </div>
                <div id="grid-wrapper"></div>
            </div>

            @* Tab: Gastos fijos *@
            <div class="tab-pane fade p-4" id="fijos" role="tabpanel">
                <div id="expenses-grid" class="row g-3">
                    <div class="col-12 text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                        <span class="ms-2 small">Cargando compromisos...</span>
                    </div>
                </div>
            </div>

            @* Tab: Ingresos Fijos *@
            <div class="tab-pane fade p-4" id="ingresos-fijos" role="tabpanel">
                <div id="incomes-grid" class="row g-3">
                    <div class="col-12 text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                        <span class="ms-2 small">Cargando ingresos fijos...</span>
                    </div>
                </div>
            </div>

            @* Tab: Presupuestos *@
            <div class="tab-pane fade p-4" id="presupuestos" role="tabpanel">
                <div id="budgets-grid" class="row g-4">
                    <div class="col-12 text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-info" role="status"></div>
                        <span class="ms-2 small">Cargando presupuestos...</span>
                    </div>
                </div>
            </div>

            @* Tab: Cuentas por persona *@
            <div class="tab-pane fade p-4" id="cuentas" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <p class="text-muted small mb-0">
                        <i class="fa-solid fa-circle-info me-1"></i>
                        Saldo acumulado que cada persona te debe por gastos atribuidos.
                    </p>
                    <a href="@Url.Action("Index", "Person")" class="btn btn-sm btn-outline-secondary">
                        <i class="fa-solid fa-users-gear me-1"></i>Administrar personas
                    </a>
                </div>
                <div id="person-accounts-grid" class="row g-3">
                    <div class="col-12 text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-success" role="status"></div>
                        <span class="ms-2 small">Calculando cuentas...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ── Modal Bootstrap: desglose proyectado ────────────────── *@
    <div class="modal fade" id="breakdownModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <i class="fa-solid fa-table-list text-primary me-1"></i>
                        <h5 class="modal-title fw-bold mb-0">
                            Desglose proyectado
                            <span class="text-body-secondary fw-normal small ms-2" id="breakdown-month-label"></span>
                        </h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="row g-0">
                        @* Columna ingresos *@
                        <div class="col-12 col-lg-6 p-4 breakdown-col-income">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                                      style="width:32px;height:32px;">
                                    <i class="fa-solid fa-arrow-trend-up text-success small"></i>
                                </span>
                                <h6 class="fw-bold mb-0 text-success-emphasis">Ingresos</h6>
                            </div>
                            <div id="breakdown-income-list">
                                <div class="text-center py-3">
                                    <div class="spinner-border spinner-border-sm text-success"></div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <span class="small text-body-secondary text-uppercase fw-semibold">Total ingresos</span>
                                <span class="text-success fs-6 fw-bold" id="breakdown-income-total">$ —</span>
                            </div>
                        </div>
                        @* Columna gastos *@
                        <div class="col-12 col-lg-6 p-4 breakdown-col-expense">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="rounded-circle bg-danger bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0"
                                      style="width:32px;height:32px;">
                                    <i class="fa-solid fa-arrow-trend-down text-danger small"></i>
                                </span>
                                <h6 class="fw-bold mb-0 text-danger-emphasis">Gastos</h6>
                            </div>
                            <div id="breakdown-expense-list">
                                <div class="text-center py-3">
                                    <div class="spinner-border spinner-border-sm text-danger"></div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <span class="small text-body-secondary text-uppercase fw-semibold">Total gastos</span>
                                <span class="text-danger fs-6 fw-bold" id="breakdown-expense-total">$ —</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/TmpTransaction.js" asp-append-version="true"></script>
    <script src="~/js/FixedExpense.js" asp-append-version="true"></script>
    <script src="~/js/FixedIncome.js" asp-append-version="true"></script>
    <script src="~/js/Budget.js" asp-append-version="true"></script>
    <script src="~/js/PersonAccounts.js" asp-append-version="true"></script>
}
