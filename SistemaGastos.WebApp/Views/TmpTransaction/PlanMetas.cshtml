@{
    ViewData["Title"] = "Plan de Metas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="debt-plan-container"
     data-url-data="@Url.Action("GetDebtPlanData", "TmpTransaction")">

    @* ── Header ───────────────────────────────────────────── *@
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-semibold mb-0" style="font-size:22px;">
                <i class="fa-solid fa-bullseye text-success me-2"></i>Plan de Metas Financieras
            </h2>
            <p class="text-muted mb-0" style="font-size:13px;">Simulá escenarios y encontrá el camino para cumplir tu objetivo</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span id="dp-save-indicator" class="dp-save-indicator">
                <i class="fa-solid fa-circle-notch fa-spin"></i>
                <span id="dp-save-text">Guardando...</span>
            </span>
            <button type="button" id="dp-reset-btn" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2"
                    title="Restablecer la simulación a los valores por defecto">
                <i class="fa-solid fa-rotate-left"></i>Restablecer
            </button>
            <a href="@Url.Action("Index", "TmpTransaction")" class="btn btn-outline-secondary btn-sm d-flex align-items-center gap-2">
                <i class="fas fa-arrow-left"></i>Volver
            </a>
        </div>
    </div>

    @* ── Loading ──────────────────────────────────────────── *@
    <div id="dp-loading" class="text-center py-5">
        <div class="spinner-border text-success" role="status"></div>
        <p class="mt-3 text-muted">Calculando proyecciones...</p>
    </div>

    @* ── Contenido principal ──────────────────────────────── *@
    <div id="dp-content" style="display:none;">

        @* ── Fila 1: Configuración de meta ───────────────── *@
        <div class="tx-table-card p-4 mb-3">
            <div class="row g-3 align-items-center">
                <div class="col-auto">
                    <span class="fw-semibold small text-body-secondary text-uppercase" style="font-size:11px;letter-spacing:.05em;">
                        Objetivo
                        <i class="fa-solid fa-circle-info ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                           title="Definí qué resultado querés lograr en los próximos 12 meses: no superar cierto saldo negativo, llegar a $0, o alcanzar un saldo positivo."></i>
                    </span>
                </div>
                <div class="col-auto">
                    <div class="btn-group" role="group">
                        <input type="radio" class="btn-check" name="goalType" id="gt-maxneg" value="maxNegative" checked>
                        <label class="btn btn-outline-danger btn-sm" for="gt-maxneg">
                            <i class="fa-solid fa-arrow-down me-1"></i>No superar negativo
                        </label>
                        <input type="radio" class="btn-check" name="goalType" id="gt-zero" value="reachZero">
                        <label class="btn btn-outline-success btn-sm" for="gt-zero">
                            <i class="fa-solid fa-equals me-1"></i>Llegar a $0
                        </label>
                        <input type="radio" class="btn-check" name="goalType" id="gt-positive" value="reachPositive">
                        <label class="btn btn-outline-info btn-sm" for="gt-positive">
                            <i class="fa-solid fa-arrow-up me-1"></i>Saldo positivo
                        </label>
                    </div>
                </div>
                <div class="col-md-3" id="dp-goal-value-wrapper">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">$</span>
                        <input type="text" class="form-control" id="dp-goal-value" inputmode="numeric" autocomplete="off"
                               placeholder="1.500.000" value="1.500.000">
                        <span class="input-group-text text-muted" style="font-size:11px;">ARS</span>
                    </div>
                    <div class="form-text mt-1" id="dp-goal-hint" style="font-size:11px;">Máximo saldo negativo permitido</div>
                </div>
            </div>
        </div>

        @* ── Fila 2: Paneles de simulación ───────────────── *@
        <div class="row g-3 mb-3">

            @* Panel: Ingreso extra *@
            <div class="col-md-6">
                <div class="tx-table-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-semibold mb-0" style="font-size:14px;">
                            <i class="fa-solid fa-briefcase me-2 text-success"></i>Ingreso extra mensual
                            <i class="fa-solid fa-circle-info text-muted ms-1" style="font-size:12px;" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Simulá cuánto extra podrías ganar por mes (ej: trabajando con Uber/Cabify) y mirá cómo cambia tu proyección."></i>
                        </h6>
                        <button class="btn btn-sm btn-outline-secondary" id="dp-toggle-scenarios" title="Comparar 3 escenarios">
                            <i class="fa-solid fa-sliders me-1"></i>3 escenarios
                        </button>
                    </div>

                    @* Modo slider único *@
                    <div id="dp-single-mode">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Extra/mes estimado</span>
                            <span class="fw-bold text-success fs-5" id="dp-extra-display">$ 0</span>
                        </div>
                        <input type="range" class="form-range" id="dp-extra-slider"
                               min="0" max="1500000" step="10000" value="0">
                        <div class="d-flex justify-content-between text-muted" style="font-size:11px;">
                            <span>$0</span><span>$500k</span><span>$1M</span><span>$1.5M</span>
                        </div>
                        <div class="mt-3 d-flex flex-wrap gap-2" id="dp-quick-picks">
                            <span class="badge rounded-pill dp-quick-pill bg-body-secondary border text-body-secondary" data-value="100000">+$100k</span>
                            <span class="badge rounded-pill dp-quick-pill bg-body-secondary border text-body-secondary" data-value="200000">+$200k</span>
                            <span class="badge rounded-pill dp-quick-pill bg-body-secondary border text-body-secondary" data-value="350000">+$350k</span>
                            <span class="badge rounded-pill dp-quick-pill bg-body-secondary border text-body-secondary" data-value="500000">+$500k</span>
                            <span class="badge rounded-pill dp-quick-pill bg-body-secondary border text-body-secondary" data-value="750000">+$750k</span>
                        </div>
                    </div>

                    @* Modo 3 escenarios *@
                    <div id="dp-scenarios-mode" style="display:none;">
                        <p class="text-muted small mb-3">Compará 3 niveles de ingreso extra simultáneamente en el gráfico.</p>
                        <div class="row g-2">
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-warning mb-1">
                                    <i class="fa-solid fa-circle-half-stroke me-1"></i>Mínimo
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$</span>
                                    <input type="text" class="form-control dp-scenario-input" id="dp-s1" inputmode="numeric" autocomplete="off" value="150.000">
                                </div>
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-primary mb-1">
                                    <i class="fa-solid fa-circle me-1"></i>Normal
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$</span>
                                    <input type="text" class="form-control dp-scenario-input" id="dp-s2" inputmode="numeric" autocomplete="off" value="350.000">
                                </div>
                            </div>
                            <div class="col-4">
                                <label class="form-label small fw-semibold text-success mb-1">
                                    <i class="fa-solid fa-circle me-1"></i>Máximo
                                </label>
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text">$</span>
                                    <input type="text" class="form-control dp-scenario-input" id="dp-s3" inputmode="numeric" autocomplete="off" value="600.000">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Panel: Cortar gastos fijos *@
            <div class="col-md-6">
                <div class="tx-table-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-semibold mb-0" style="font-size:14px;">
                            <i class="fa-solid fa-scissors me-2 text-danger"></i>Simular corte de gastos fijos
                            <i class="fa-solid fa-circle-info text-muted ms-1" style="font-size:12px;" data-bs-toggle="tooltip" data-bs-placement="top"
                               title="Marcá los gastos fijos que podrías pausar o cancelar para ver cuánto mejorarían tus proyecciones mes a mes."></i>
                        </h6>
                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle" id="dp-reduction-badge" style="display:none;">
                            -<span id="dp-reduction-total">$0</span>/mes
                        </span>
                    </div>
                    <div id="dp-expenses-list" class="dp-expenses-list">
                        <div class="text-muted small text-center py-3">
                            <div class="spinner-border spinner-border-sm text-secondary"></div>
                            <span class="ms-2">Cargando gastos fijos...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Fila 3: Cards resumen ────────────────────────── *@
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3">
                <div class="dp-summary-card">
                    <div class="dp-summary-icon"><i class="fa-solid fa-wallet"></i></div>
                    <div class="dp-summary-label">
                        Saldo actual
                        <i class="fa-solid fa-circle-info ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                           title="Suma de los saldos líquidos de tus cuentas (excluye tarjetas de crédito), convertidos a ARS al dólar MEP."></i>
                    </div>
                    <div class="dp-summary-value" id="dp-card-balance">$ —</div>
                    <div class="dp-summary-sub">Liquidez total</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="dp-summary-card dp-summary-card-highlight">
                    <div class="dp-summary-icon text-success"><i class="fa-solid fa-flag-checkered"></i></div>
                    <div class="dp-summary-label">
                        Mes de cumplimiento
                        <i class="fa-solid fa-circle-info ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                           title="Primer mes en el que tu saldo proyectado alcanza la meta definida, según la simulación actual."></i>
                    </div>
                    <div class="dp-summary-value" id="dp-card-breakeven">—</div>
                    <div class="dp-summary-sub" id="dp-card-breakeven-sub">Primer mes que alcanza el objetivo</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="dp-summary-card">
                    <div class="dp-summary-icon text-warning"><i class="fa-solid fa-calculator"></i></div>
                    <div class="dp-summary-label">
                        Extra mínimo necesario
                        <i class="fa-solid fa-circle-info ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                           title="Ingreso extra mensual mínimo que necesitarías para cumplir la meta en todos los meses proyectados."></i>
                    </div>
                    <div class="dp-summary-value" id="dp-card-min-extra">$ —</div>
                    <div class="dp-summary-sub">Para cumplir todos los meses</div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="dp-summary-card">
                    <div class="dp-summary-icon text-info"><i class="fa-solid fa-scissors"></i></div>
                    <div class="dp-summary-label">
                        Reducción de gastos
                        <i class="fa-solid fa-circle-info ms-1" data-bs-toggle="tooltip" data-bs-placement="top"
                           title="Suma mensual de los gastos fijos que marcaste para simular su corte."></i>
                    </div>
                    <div class="dp-summary-value" id="dp-card-reduction">$ 0/mes</div>
                    <div class="dp-summary-sub" id="dp-card-reduction-sub">Ningún gasto seleccionado</div>
                </div>
            </div>
        </div>

        @* ── Fila 3.5: Salud del plan (progreso hacia la meta) ──── *@
        <div class="tx-table-card p-4 mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                <h6 class="fw-semibold mb-0" style="font-size:14px;">
                    <i class="fa-solid fa-gauge-high me-2 text-success"></i>Salud del plan
                    <i class="fa-solid fa-circle-info text-muted ms-1" style="font-size:12px;" data-bs-toggle="tooltip" data-bs-placement="top"
                       title="Cada barra representa un mes del horizonte de 12 meses. Verde = cumple la meta, amarillo = cerca, rojo = en riesgo. Pasá el mouse para ver el detalle."></i>
                </h6>
                <span class="small fw-semibold text-body-secondary" id="dp-progress-label">— / 12 meses cumplen</span>
            </div>
            <div class="dp-progress-segments" id="dp-progress-segments"></div>
        </div>

        @* ── Fila 4: Gráfico ─────────────────────────────── *@
        <div class="tx-table-card p-4 mb-3">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h6 class="fw-semibold mb-1" style="font-size:14px;">
                        <i class="fa-solid fa-chart-line me-2 text-primary"></i>Proyección de saldo
                    </h6>
                    <p class="text-muted mb-0" style="font-size:12px;">Evolución mensual del saldo según los parámetros configurados</p>
                </div>
                <div id="dp-chart-legend" class="d-flex flex-wrap gap-3 align-items-center"></div>
            </div>
            <canvas id="dp-chart" style="max-height:320px;"></canvas>
        </div>

        @* ── Fila 5: Tabla mensual ────────────────────────── *@
        <div class="tx-table-card mb-4">
            <div class="p-4 pb-0 d-flex justify-content-between align-items-center">
                <h6 class="fw-semibold mb-0" style="font-size:14px;">
                    <i class="fa-solid fa-calendar-days me-2 text-secondary"></i>Detalle mensual
                </h6>
                <div class="d-flex gap-2" style="font-size:11px;">
                    <span class="badge bg-success-subtle text-success border border-success-subtle">✓ Cumple</span>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle">⚠ Cerca</span>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle">✗ Riesgo</span>
                </div>
            </div>
            <div class="table-responsive mt-3">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-active">
                        <tr style="font-size:12px;">
                            <th class="ps-4">Mes</th>
                            <th class="text-end">Ingresos</th>
                            <th class="text-end">Gastos fijos</th>
                            <th class="text-end">Ingreso extra acum.</th>
                            <th class="text-end">Saldo proyectado</th>
                            <th class="text-end">Delta vs meta</th>
                            <th class="text-center pe-4">Estado</th>
                        </tr>
                    </thead>
                    <tbody id="dp-table-body"></tbody>
                </table>
            </div>
        </div>

    </div>@* fin #dp-content *@
</div>@* fin #debt-plan-container *@

@section Scripts {
    <script src="~/js/DebtPlan.js" asp-append-version="true"></script>
}
