@model SistemaGastos.Application.DTOs.FixedIncomeFormDto

<form id="incomeForm" class="needs-validation" novalidate>
    @Html.AntiForgeryToken()
    <input type="hidden" id="FI_ID" value="@Model.Income.ID" />

    <!-- Nombre -->
    <div class="mb-3">
        <label for="FI_Name" class="form-label fw-bold">
            <i class="fas fa-tag text-success me-2"></i>Nombre del ingreso
            <span class="text-danger">*</span>
        </label>
        <input type="text" class="form-control" id="FI_Name" value="@Model.Income.Name"
               placeholder="Ej: Sueldo, Alquiler cobrado..." required autocomplete="off" />
    </div>

    <!-- Monto + Moneda -->
    <div class="row mb-3 g-2">
        <div class="col-md-5">
            <label for="FI_Amount" class="form-label fw-bold">
                <i class="fas fa-dollar-sign text-success me-2"></i>Monto
                <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <span class="input-group-text bg-success bg-opacity-10 text-success" id="fi-currency-symbol">$</span>
                <input type="number" step="0.01" class="form-control" id="FI_Amount"
                       value="@Model.Income.Amount" placeholder="0,00" min="0.01" required />
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label fw-bold">Moneda</label>
            <select class="form-select" id="FI_Currency">
                <option value="ARS" selected="@(Model.Income.Currency == "ARS")">ARS $</option>
                <option value="USD" selected="@(Model.Income.Currency == "USD")">USD U$S</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label fw-bold">Día de cobro</label>
            <div class="input-group">
                <span class="input-group-text bg-success bg-opacity-10 text-success">
                    <i class="fas fa-calendar-day"></i>
                </span>
                <input type="number" class="form-control" id="FI_ReceiptDay"
                       value="@Model.Income.ReceiptDay" min="1" max="31" placeholder="1" required />
            </div>
            <small class="text-muted">Del 1 al 31</small>
        </div>
    </div>

    <!-- Distribución diaria -->
    <div class="tmp-distribution-box mb-3">
        <div class="tmp-distribution-toggle">
            <div class="form-check form-switch mb-0">
                <input class="form-check-input"
                       type="checkbox"
                       id="checkDistribuirFI"
                       data-initial-end-day="@Model.Income.DistributionEndDay"
                       data-initial-excluded="@Model.Income.ExcludedDays"
                @(Model.Income.DistributionEndDay.HasValue ? "checked" : "") />
                <label class="form-check-label" for="checkDistribuirFI">
                    <span class="tmp-recurrence-title">
                        <i class="fas fa-layer-group me-1"></i>Repartir en varios días
                    </span>
                    <span class="tmp-recurrence-sub">Reparte el monto entre el día de cobro y el día final, salteando los días que excluyas</span>
                </label>
            </div>
        </div>

        <div id="panel-distribucion-fi" class="tmp-distribution-panel" style="display:none;">
            <label class="tmp-label" for="DistributionEndDayFI">Repartir hasta el día</label>
            <input type="number"
                   id="DistributionEndDayFI"
                   class="form-control"
                   style="max-width:120px;"
                   min="1" max="31"
                   value="@Model.Income.DistributionEndDay" />
            <div class="tmp-days-grid" id="distribucion-dias-grid-fi"></div>
            <div class="tmp-days-grid-hint mt-2">Hacé clic en un día para excluirlo del reparto.</div>
        </div>
    </div>

    <!-- Preview conversión USD -->
    <div id="fi-usd-preview" class="alert alert-info py-2 mb-3 small" style="display:none;">
        <i class="fas fa-exchange-alt me-1"></i>
        Cotización MEP: <strong id="fi-dolar-rate">@Model.DolarMep.ToString("N2")</strong>
        → <strong id="fi-ars-preview">—</strong>
    </div>

    <!-- Cuenta y Categoría -->
    <div class="row mb-3 g-2">
        <div class="col-md-6">
            <label for="FI_AccountID" class="form-label fw-bold">
                <i class="fas fa-wallet text-info me-2"></i>Cuenta de acreditación
                <span class="text-danger">*</span>
            </label>
            <select class="form-select" id="FI_AccountID" required>
                <option value="">Seleccionar cuenta...</option>
                @foreach (var account in Model.Accounts)
                {
                    <option value="@account.ID" selected="@(account.ID == Model.Income.AccountID)">
                        @account.Name (@account.Type)
                    </option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label for="FI_CategoryID" class="form-label fw-bold">
                <i class="fas fa-folder text-success me-2"></i>Categoría
                <span class="text-danger">*</span>
            </label>
            <select class="form-select" id="FI_CategoryID" required>
                <option value="">Seleccionar...</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.ID" selected="@(cat.ID == Model.Income.CategoryID)">
                        @cat.Name
                    </option>
                }
            </select>
        </div>
    </div>

    <!-- Fecha de inicio -->
    <div class="mb-3">
        <label for="FI_StartDate" class="form-label fw-bold">
            <i class="fas fa-calendar-plus text-primary me-2"></i>Fecha de inicio
            <span class="badge bg-secondary ms-1">Opcional</span>
        </label>
        <input type="date" class="form-control" id="FI_StartDate"
               value="@(Model.Income.StartDate?.ToString("yyyy-MM-dd") ?? "")" />
        <small class="text-muted">
            <i class="fas fa-info-circle me-1"></i>
            Si no se indica, se incluye desde el mes actual
        </small>
    </div>

    <!-- Logo URL -->
    <div class="mb-3">
        <label for="FI_LogoUrl" class="form-label fw-bold">
            <i class="fas fa-image text-secondary me-2"></i>URL del Logo
            <span class="badge bg-secondary ms-1">Opcional</span>
        </label>
        <input type="url" class="form-control" id="FI_LogoUrl"
               value="@Model.Income.LogoUrl" placeholder="https://..." />
    </div>
</form>

<script>
(function () {
    const dolarRate = parseFloat('@Model.DolarMep.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)') || 0;
    const fmt = new Intl.NumberFormat('es-AR', { style: 'currency', currency: 'ARS' });

    function updatePreview() {
        const currency = document.getElementById('FI_Currency').value;
        const amount = parseFloat(document.getElementById('FI_Amount').value) || 0;
        const preview = document.getElementById('fi-usd-preview');
        const symbol = document.getElementById('fi-currency-symbol');

        if (currency === 'USD') {
            preview.style.display = 'block';
            symbol.textContent = 'U$S';
            document.getElementById('fi-ars-preview').textContent =
                dolarRate > 0 ? fmt.format(amount * dolarRate) : '—';
        } else {
            preview.style.display = 'none';
            symbol.textContent = '$';
        }
    }

    document.getElementById('FI_Currency').addEventListener('change', updatePreview);
    document.getElementById('FI_Amount').addEventListener('input', updatePreview);
    updatePreview();
})();
</script>
