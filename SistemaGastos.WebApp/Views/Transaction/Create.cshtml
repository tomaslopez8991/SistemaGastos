@model SistemaGastos.Application.DTOs.TransactionFormDto
@{
    ViewData["Title"] = "Nuevo Movimiento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="bg-body-tertiary min-vh-100 pb-5" style="margin: -1rem -1rem 0 -1rem; padding: 2rem 1rem;">
    <div class="container-fluid max-w-1000 mx-auto" id="create-page-container"
         data-url-create="@Url.Action("CreateBulk", "Transaction")"
         data-url-index="@Url.Action("Index", "Transaction")">
        
        <div class="d-flex justify-content-between align-items-center mb-4 px-2">
            <div>
                <h3 class="fw-bolder mb-0 text-body-emphasis">Registrar Movimientos</h3>
                <p class="text-body-secondary small mb-0">Carga simple o lotes multicuentas</p>
            </div>
            <a href="@Url.Action("Index")" class="btn rounded-pill shadow-sm fw-bold px-4">
                <i class="fa-solid fa-arrow-left me-2"></i>Volver
            </a>
        </div>

        <form id="unifiedTransactionForm">
            @Html.AntiForgeryToken()

            <div id="unifiedTransactionsContainer" class="d-flex flex-column gap-3">
            </div>

            <div class="text-center mt-4 mb-5">
                <button type="button" class="btn btn-link text-decoration-none text-body-secondary fw-bold p-3" id="btnAddNewTxBlock">
                    <i class="fa-solid fa-plus-circle me-2 fs-5 text-primary"></i>Agregar otro movimiento
                </button>
            </div>

            <div class="position-sticky bottom-0 z-3" style="padding-bottom: 2rem;">
                <div class="card border-0 shadow-lg rounded-pill bg-body mx-auto" style="max-width: 800px;">
                    <div class="card-body d-flex justify-content-between align-items-center py-2 px-4">
                        <div class="d-flex align-items-center gap-4">
                            <div class="text-center">
                                <span class="text-body-secondary small fw-bold d-block lh-1 mb-1">Items</span>
                                <span id="lblTotalTxCount" class="badge text-bg-primary rounded-pill">0</span>
                            </div>
                            <div>
                                <span class="text-body-secondary small fw-bold d-block lh-1 mb-1">Total Lote</span>
                                <span id="lblTotalBatchAmount" class="fs-5 text-success fw-bolder">$ 0.00</span>
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn fw-bold rounded-pill px-4 d-none d-md-block" onclick="window.history.back()">Cancelar</button>
                            <button type="submit" class="btn btn-primary fw-bold rounded-pill px-4 px-md-5 shadow-sm" id="btnSaveUnified">
                                Guardar
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

<template id="tplTransactionBlock">
    <div class="card border-0 shadow-sm rounded-4 tx-block bg-body">
        <div class="card-header bg-transparent border-0 pt-4 pb-0 px-4 d-flex justify-content-between align-items-center">
            <span class="fw-bolder fs-5 text-body-emphasis">Movimiento <span class="tx-number text-primary"></span></span>
            <button type="button" class="btn btn-sm text-danger btn-remove-tx rounded-circle p-2" title="Eliminar este movimiento">
                <i class="fa-solid fa-trash"></i>
            </button>
        </div>
        
        <div class="card-body p-4">
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="form-floating">
                        <input type="date" class="form-control rounded-3 tx-date" required placeholder="Fecha" />
                        <label class="text-body-secondary">Fecha</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-floating">
                        <select class="form-select rounded-3 tx-category" required>
                            <option value="">Seleccione...</option>
                            @if (Model.Categories != null)
                            {
                                foreach (var cat in Model.Categories)
                                {
                                    <option value="@cat.ID">@cat.Name</option>
                                }
                            }
                        </select>
                        <label class="text-body-secondary">Categoría</label>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="form-floating">
                        <input type="text" class="form-control rounded-3 tx-desc" placeholder="Descripción" required/>
                        <label class="text-body-secondary">Descripción</label>
                    </div>
                </div>
            </div>

            <div class="splits-wrapper bg-body-tertiary p-3 p-md-4 rounded-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="small fw-bold text-body-secondary text-uppercase tracking-wide"><i class="fa-solid fa-wallet me-2"></i>Cuentas</span>
                    <button type="button" class="btn btn-sm text-primary fw-bold rounded-pill btn-add-split shadow-sm">
                        <i class="fa-solid fa-plus me-1"></i>Dividir pago
                    </button>
                </div>
                <div class="splits-container d-flex flex-column gap-2"></div>
            </div>
        </div>
    </div>
</template>

<template id="tplSplitRow">
    <div class="row g-2 split-row align-items-center position-relative">
        <div class="col-md-6">
            <div class="form-floating">
                <select class="form-select rounded-3 split-account border-0 shadow-sm" required>
                    <option value="">Seleccione cuenta...</option>
                    @if (Model.Accounts != null)
                    {
                        foreach (var acc in Model.Accounts)
                        {
                            <option value="@acc.ID">@acc.Name (@acc.Currency)</option>
                        }
                    }
                </select>
                <label class="text-body-secondary">Cuenta</label>
            </div>
        </div>
        <div class="col-md-5">
            <div class="form-floating">
                <input type="number" step="0.01" class="form-control rounded-3 split-amount fw-bold fs-5 text-primary border-0 shadow-sm" placeholder="0.00" required />
                <label class="text-body-secondary">Monto ($)</label>
            </div>
        </div>
        <div class="col-md-1 text-center mt-2 mt-md-0">
            <button type="button" class="btn text-danger rounded-circle p-2 btn-remove-split shadow-sm" style="display:none;" title="Quitar cuenta">
                <i class="fa-solid fa-times"></i>
            </button>
        </div>
    </div>
</template>

@section Scripts {
    <script src="~/js/CreateTransaction.js" asp-append-version="true"></script>
}