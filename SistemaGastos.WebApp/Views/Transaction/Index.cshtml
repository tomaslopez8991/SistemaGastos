@{
    ViewData["Title"] = "Movimientos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

<div id="transaction-container"
     data-url-list="@Url.Action("GetList", "Transaction")"
     data-url-create="@Url.Action("CreateBulk", "Transaction")"
     data-url-save="@Url.Action("Save", "Transaction")"
     data-url-delete="@Url.Action("Delete", "Transaction")"
     data-url-create-form="@Url.Action("GetCreateForm", "Transaction")"
     data-url-edit-form="@Url.Action("GetEditForm", "Transaction")"
     data-url-dropdown-data="@Url.Action("GetDropdownData", "Transaction")"
     data-intro="Bienvenido al módulo de Transacciones. Aquí registras todos tus ingresos y gastos reales del día a día. Es el corazón del sistema: cada movimiento que hagas impacta en tus cuentas, presupuestos y estadísticas."
     data-step="1">

    @* Header *@
    <div class="d-flex justify-content-between align-items-start mb-4"
         data-intro="Desde este encabezado puedes ver el listado completo de tus movimientos financieros y crear nuevos registros."
         data-step="2">
        <div>
            <h2 class="fw-semibold mb-0" style="font-size:22px;">
                <i class="fas fa-exchange-alt text-primary me-2"></i>Movimientos
            </h2>
            <p class="text-muted mb-0" style="font-size:13px;">Gestiona tus ingresos y gastos</p>
        </div>
        <a href="@Url.Action("Create", "Transaction")"
               class="btn btn-primary d-flex align-items-center gap-2"
               id="btnNewTransaction"
               data-intro="Haz clic aquí para registrar uno o varios movimientos a la vez. Puedes crear múltiples transacciones en una sola operación para ahorrar tiempo."
               data-step="3">
            <i class="fas fa-plus"></i>Nuevo Movimiento
        </a>
    </div>

    @* Stats rápidas *@
    <div class="tx-stat-row">
        <div class="tx-stat-card">
            <div class="tx-stat-label"><i class="fas fa-arrow-up me-1"></i>Ingresos del mes</div>
            <div class="tx-stat-value tx-income" id="statIncome">$ 0,00</div>
        </div>
        <div class="tx-stat-card">
            <div class="tx-stat-label"><i class="fas fa-arrow-down me-1"></i>Gastos del mes</div>
            <div class="tx-stat-value tx-expense" id="statExpense">$ 0,00</div>
        </div>
        <div class="tx-stat-card">
            <div class="tx-stat-label"><i class="fas fa-balance-scale me-1"></i>Balance neto</div>
            <div class="tx-stat-value tx-balance" id="statBalance">$ 0,00</div>
        </div>
    </div>

    @* Filtros *@
    <div class="tx-filters-card"
         data-intro="Usa estos filtros para buscar movimientos específicos por fecha, cuenta o categoría."
         data-step="4">
        <div class="tx-filters-inner">
            <div>
                <label class="tx-filter-label" for="filterStart"
                       data-intro="Filtra desde una fecha específica." data-step="5">Desde</label>
                <input type="date" class="form-control form-control-sm" id="filterStart" />
            </div>
            <div>
                <label class="tx-filter-label" for="filterEnd"
                       data-intro="Filtra hasta una fecha límite." data-step="6">Hasta</label>
                <input type="date" class="form-control form-control-sm" id="filterEnd" />
            </div>
            <div>
                <label class="tx-filter-label" for="filterAccount"
                       data-intro="Filtra movimientos de una cuenta específica." data-step="7">Cuenta</label>
                <select class="form-select form-select-sm" id="filterAccount">
                    <option value="">Todas las cuentas</option>
                </select>
            </div>
            <div>
                <label class="tx-filter-label" for="filterCategory"
                       data-intro="Filtra por categoría para ver solo gastos de un tipo." data-step="8">Categoría</label>
                <select class="form-select form-select-sm" id="filterCategory">
                    <option value="">Todas las categorías</option>
                </select>
            </div>
            <div class="tx-filter-actions">
                <button class="btn btn-primary btn-sm d-flex align-items-center gap-1"
                        id="btnApplyFilters"
                        data-intro="Aplica los filtros seleccionados." data-step="9">
                    <i class="fas fa-filter"></i>Filtrar
                </button>
                <button class="btn btn-outline-secondary btn-sm"
                        id="btnClearFilters"
                        title="Limpiar filtros"
                        data-intro="Limpia todos los filtros." data-step="10">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
    </div>

    @* Tabla *@
    <div class="tx-table-card"
         data-intro="Esta tabla muestra todos tus movimientos. Los ingresos aparecen en verde y los gastos en rojo."
         data-step="11">
        <div id="grid-wrapper"></div>
    </div>
</div>

@* Modal: Crear *@
<div class="modal fade" id="modalCreateTransaction" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg" id="modalCreateContent">
            <div class="text-center p-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 text-muted small">Cargando formulario...</div>
            </div>
        </div>
    </div>
</div>

@* Modal: Editar *@
<div class="modal fade" id="modalEditTransaction" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content shadow-lg" id="modalEditContent">
            <div class="text-center p-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2 text-muted small">Cargando datos...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Transactions.js" asp-append-version="true"></script>
}
