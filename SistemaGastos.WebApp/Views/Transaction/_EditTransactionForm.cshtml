@model SistemaGastos.Application.DTOs.TransactionFormDto
@{
    Layout = null;
}

<form id="editTransactionForm">
    @Html.AntiForgeryToken()
    <input type="hidden" id="Edit_Transaction_ID" value="@Model.ID" />

    <div class="modal-header bg-primary text-white">
        <h5 class="modal-title"><i class="fa-solid fa-pen me-2"></i>Editar Movimiento</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body">
        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label fw-bold">Fecha</label>
                <input type="date" id="Edit_Transaction_Date" class="form-control" value="@(Model.Date?.ToString("yyyy-MM-dd"))" required />
            </div>
            <div class="col-md-6">
                <label class="form-label fw-bold">Categoría</label>
                <select class="form-select" id="Edit_Transaction_CategoryID" required>
                    <option value="">Seleccione...</option>
                    @if (Model.Categories != null)
                    {
                        foreach (var category in Model.Categories)
                        {
                            <option value="@category.ID" selected="@(Model.CategoryID == category.ID)">@category.Name</option>
                        }
                    }
                </select>
            </div>
        </div>

        <hr class="text-secondary opacity-25">
        
        <div class="d-flex justify-content-between align-items-center mb-2">
            <label class="form-label fw-bold mb-0">Distribución de Fondos</label>
            <button type="button" class="btn btn-sm btn-outline-success rounded-pill" id="btnEditAddSplitRow">
                <i class="fa-solid fa-plus me-1"></i> Agregar Cuenta
            </button>
        </div>

        <div id="editSplitsContainer">
            <div class="edit-split-row row mb-2 align-items-center">
                <div class="col-6">
                    <select class="form-select edit-split-account" required>
                        <option value="">Seleccione cuenta...</option>
                        @if (Model.Accounts != null)
                        {
                            foreach (var account in Model.Accounts)
                            {
                                <option value="@account.ID" selected="@(Model.AccountID == account.ID)">@account.Name (@account.Currency)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-5">
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input type="number" step="0.01" class="form-control edit-split-amount" value="@Model.Amount" placeholder="0.00" required />
                    </div>
                </div>
                <div class="col-1 text-end">
                    <button type="button" class="btn btn-link text-danger p-0 btn-remove-edit-split" style="display:none;"><i class="fa-solid fa-trash"></i></button>
                </div>
            </div>
        </div>
        
        <div class="text-end mb-3">
            <small class="text-muted fw-bold">Total: $<span id="lblEditTotalAmount">@Model.Amount.ToString("N2")</span></small>
        </div>

        <hr class="text-secondary opacity-25">

        <div class="mb-3">
            <label class="form-label fw-bold">Descripción</label>
            <textarea class="form-control" id="Edit_Transaction_Description" rows="2">@Model.Description</textarea>
        </div>

        @if (Model.FixedExpenses != null && Model.FixedExpenses.Any())
        {
            <div class="mb-3">
                <label class="form-label fw-bold">Gasto Fijo Asociado</label>
                <select class="form-select" id="Edit_Transaction_FixedExpenseID">
                    <option value="">Sin asociar</option>
                    @foreach (var expense in Model.FixedExpenses)
                    {
                        <option value="@expense.ID" selected="@(Model.FixedExpenseID == expense.ID)">@expense.Name</option>
                    }
                </select>
            </div>
        }

        @if (Model.Persons != null && Model.Persons.Any())
        {
            <div class="mb-3">
                <label class="form-label fw-bold">
                    <i class="fa-solid fa-user me-1"></i>Solicitado por
                </label>
                <select class="form-select" id="Edit_Transaction_PersonID">
                    <option value="">— Propio (sin atribución) —</option>
                    @foreach (var p in Model.Persons)
                    {
                        <option value="@p.ID" selected="@(Model.PersonID == p.ID)">@p.Name</option>
                    }
                </select>
            </div>
        }
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary" id="btnUpdateTransaction">
            <i class="fas fa-save me-1"></i> Actualizar
        </button>
    </div>
</form>