@{
    ViewData["Title"] = "Dashboard Financiero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div id="statistics-container"
     data-url-stats="@Url.Action("GetStatistics", "Transaction")"
     data-intro="Resumen financiero completo: patrimonio, actividad del mes, tendencia histórica y top de categorías."
     data-step="1">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-0">
                <i class="fas fa-chart-line text-primary me-2"></i>Dashboard Financiero
            </h2>
            <p class="text-muted small mb-0">
                Vista general de tus finanzas &middot;
                <span id="lastUpdated" class="fst-italic">Cargando...</span>
            </p>
        </div>
        <button class="btn btn-outline-primary btn-sm"
                onclick="location.reload()">
            <i class="fas fa-sync-alt me-2"></i>Actualizar
        </button>
    </div>

    <!-- Fila 1: KPIs Patrimoniales -->
    <div class="row g-3 mb-4"
         data-intro="Patrimonio neto = saldo total menos deudas de tarjeta. Es el indicador más importante de tu salud financiera."
         data-step="2">
        <div class="col-md-4">
            <div class="card h-100 border-primary shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <small class="text-muted text-uppercase" style="letter-spacing:.05em">Patrimonio Neto</small>
                        <i class="fas fa-coins fs-3 text-primary opacity-25"></i>
                    </div>
                    <h2 class="fw-bold mb-0 text-primary" id="netWorth">$ -</h2>
                    <small class="text-muted">Saldo - Deudas</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-success shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <small class="text-muted text-uppercase" style="letter-spacing:.05em">Saldo Total</small>
                        <i class="fas fa-wallet fs-3 text-success opacity-25"></i>
                    </div>
                    <h2 class="fw-bold mb-0 text-success" id="totalBalance">$ -</h2>
                    <small class="text-muted" id="accountCount">- cuentas</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-danger shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <small class="text-muted text-uppercase" style="letter-spacing:.05em">Deuda Tarjetas</small>
                        <i class="fas fa-credit-card fs-3 text-danger opacity-25"></i>
                    </div>
                    <h2 class="fw-bold mb-0 text-danger" id="totalDebt">$ -</h2>
                    <small class="text-muted" id="installmentCount">- cuotas activas</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 2: Mes Actual -->
    <div class="row g-3 mb-4"
         data-intro="Actividad del mes: ingresos, gastos, ahorro y ritmo diario. El badge muestra la variación vs el mes anterior."
         data-step="3">
        <div class="col-md-3">
            <div class="card h-100 border-success shadow-sm">
                <div class="card-body">
                    <small class="text-success fw-bold text-uppercase">Ingresos del Mes</small>
                    <h3 class="fw-bold mb-1 text-success" id="currentIncome">$ -</h3>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge" id="incomeVariation">-</span>
                        <small class="text-muted">vs mes anterior</small>
                    </div>
                    <small class="text-muted">Anterior: <span id="lastMonthIncome" class="fw-semibold">$ -</span></small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-danger shadow-sm">
                <div class="card-body">
                    <small class="text-danger fw-bold text-uppercase">Gastos del Mes</small>
                    <h3 class="fw-bold mb-1 text-danger" id="currentExpense">$ -</h3>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge" id="expenseVariation">-</span>
                        <small class="text-muted">vs mes anterior</small>
                    </div>
                    <small class="text-muted">Anterior: <span id="lastMonthExpense" class="fw-semibold">$ -</span></small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-info shadow-sm">
                <div class="card-body">
                    <small class="text-info fw-bold text-uppercase">Ahorro del Mes</small>
                    <h3 class="fw-bold mb-1 text-info" id="currentSavings">$ -</h3>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <small class="text-muted">Tasa de ahorro</small>
                        <small class="fw-bold text-info" id="savingsRateText">- %</small>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-info" id="savingsRateBar" role="progressbar"
                             style="width: 0%" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 border-warning shadow-sm">
                <div class="card-body">
                    <small class="text-warning fw-bold text-uppercase">Gasto Diario Prom.</small>
                    <h3 class="fw-bold mb-1 text-warning" id="avgDailyExpense">$ -</h3>
                    <small class="text-muted">Faltan <span id="daysLeft" class="fw-bold">-</span> días del mes</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 3: Tendencia 6 Meses -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card shadow-sm"
                 data-intro="Tendencia histórica: ingresos (verde) vs gastos (rojo) de los últimos 6 meses. Si el verde supera al rojo, estás generando ahorro."
                 data-step="4">
                <div class="card-header border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0">
                        <i class="fas fa-chart-bar text-primary me-2"></i>Tendencia — Últimos 6 Meses
                    </h5>
                    <div class="d-flex gap-3">
                        <small class="d-flex align-items-center gap-1">
                            <span class="d-inline-block rounded" style="width:12px;height:12px;background:rgba(25,135,84,0.75)"></span>
                            Ingresos
                        </small>
                        <small class="d-flex align-items-center gap-1">
                            <span class="d-inline-block rounded" style="width:12px;height:12px;background:rgba(220,53,69,0.75)"></span>
                            Gastos
                        </small>
                    </div>
                </div>
                <div class="card-body" style="position:relative; height:260px;">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 4: Top Categorías -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm"
                 data-intro="Top categorías del mes por gasto e ingreso. <span class='tut-action'>→ Revisá dónde concentrar tu ahorro mirando el ranking de gastos.</span>"
                 data-step="5">
                <div class="card-header border-bottom">
                    <h5 class="mb-0"><i class="fas fa-fire text-danger me-2"></i>Top Gastos del Mes</h5>
                </div>
                <div class="card-body">
                    <div class="row g-0 align-items-center">
                        <div class="col-5 d-flex justify-content-center">
                            <canvas id="expensePieChart" style="max-height:180px;max-width:180px;"></canvas>
                        </div>
                        <div class="col-7" id="topExpenses">
                            <div class="d-flex justify-content-center align-items-center py-4">
                                <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm">
                <div class="card-header border-bottom">
                    <h5 class="mb-0"><i class="fas fa-arrow-trend-up text-success me-2"></i>Top Ingresos del Mes</h5>
                </div>
                <div class="card-body" id="topIncomes">
                    <div class="d-flex justify-content-center align-items-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 5: Distribución de Cuentas + Proyecciones -->
    <div class="row g-3 mb-4">
        <div class="col-md-5">
            <div class="card h-100 shadow-sm">
                <div class="card-header border-bottom">
                    <h5 class="mb-0"><i class="fas fa-wallet text-success me-2"></i>Distribución de Cuentas</h5>
                </div>
                <div class="card-body" id="accountsDistribution">
                    <div class="d-flex justify-content-center align-items-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card h-100 shadow-sm">
                <div class="card-header border-bottom">
                    <h6 class="mb-0"><i class="fas fa-crystal-ball text-primary me-2"></i>Proyecciones</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="p-3 rounded border h-100">
                                <small class="text-muted d-block mb-1">Saldo estimado fin de mes</small>
                                <h5 class="fw-bold mb-0" id="estimatedBalance">$ -</h5>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="p-3 rounded border h-100">
                                <small class="text-muted d-block mb-1">Cuotas próximo mes</small>
                                <h5 class="fw-bold mb-0 text-warning" id="nextMonthInstallments">$ -</h5>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="p-3 rounded border border-primary">
                                <small class="text-muted d-block mb-1">Saldo proyectado próximo mes</small>
                                <h4 class="fw-bold mb-0 text-primary" id="projectedBalance">$ -</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Fila 6: Últimas Transacciones -->
    <div class="row g-3 mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header border-bottom">
                    <h6 class="mb-0"><i class="fas fa-history text-secondary me-2"></i>Últimas Transacciones</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0" id="recentTransactions">
                            <tbody>
                                <tr>
                                    <td colspan="3" class="text-center py-5">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Cargando...</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/Statistics.js" asp-append-version="true"></script>
}
