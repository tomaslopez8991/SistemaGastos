@model SistemaGastos.Application.DTOs.TransactionFormDto
@{
    Layout = null;
}

<form id="unifiedTransactionForm">
    @Html.AntiForgeryToken()

    <div class="modal-header bg-primary">
        <h5 class="modal-title">
            <i class="fa-solid fa-layer-group me-2"></i>Registrar Movimientos
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="modal-body bg-body-tertiary">
        
        <div id="unifiedTransactionsContainer">
        </div>

        <div class="text-center mt-3">
            <button type="button" class="btn btn-outline-primary border-dashed w-100 py-3 fw-bold" id="btnAddNewTxBlock">
                <i class="fa-solid fa-plus-circle me-2"></i>Agregar Otro Movimiento (Carga Masiva)
            </button>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 p-3 rounded shadow-sm border">
            <span class="text-muted fw-bold">Total de movimientos: <span id="lblTotalTxCount" class="badge bg-primary fs-6 ms-1">0</span></span>
            <span class="text-muted fw-bold">Suma total: <span id="lblTotalBatchAmount" class="fs-5 text-success fw-bolder ms-1">$ 0.00</span></span>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" class="btn btn-secondary fw-bold" data-bs-dismiss="modal">Cancelar</button>
        <button type="submit" class="btn btn-primary fw-bold" id="btnSaveUnified">
            <i class="fas fa-save me-1"></i> Guardar Todo
        </button>
    </div>
</form>

<template id="tplTransactionBlock">
    <div class="card shadow-sm mb-3 tx-block border-primary border-opacity-25">
        <div class="card-header d-flex justify-content-between align-items-center py-2">
            <span class="fw-bold text-primary"><i class="fa-solid fa-receipt me-2"></i>Movimiento <span class="tx-number"></span></span>
            <button type="button" class="btn btn-sm btn-outline-danger btn-remove-tx" title="Eliminar este movimiento"><i class="fa-solid fa-trash"></i></button>
        </div>
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Fecha</label>
                    <input type="date" class="form-control form-control-sm tx-date" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1">Categoría</label>
                    <select class="form-select form-select-sm tx-category" required>
                        <option value="">Seleccione...</option>
                        @if (Model.Categories != null)
                        {
                            foreach (var cat in Model.Categories)
                            {
                                <option value="@cat.ID">@cat.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-muted mb-1">Descripción</label>
                    <input type="text" class="form-control form-control-sm tx-desc" placeholder="Opcional..." />
                </div>
            </div>

            <div class="splits-wrapper border-start border-3 border-success ps-3 mt-2">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-success small fw-bold">Distribución de fondos</span>
                    <button type="button" class="btn btn-sm btn-link text-success p-0 text-decoration-none fw-bold btn-add-split">
                        <i class="fa-solid fa-plus me-1"></i>Dividir en otra cuenta
                    </button>
                </div>
                <div class="splits-container">
                </div>
            </div>
        </div>
    </div>
</template>

<template id="tplSplitRow">
    <div class="row g-2 mb-2 split-row align-items-center">
        <div class="col-6">
            <select class="form-select form-select-sm split-account" required>
                <option value="">Cuenta...</option>
                @if (Model.Accounts != null)
                {
                    foreach (var acc in Model.Accounts)
                    {
                        <option value="@acc.ID">@acc.Name (@acc.Currency)</option>
                    }
                }
            </select>
        </div>
        <div class="col-5">
            <div class="input-group input-group-sm">
                <span class="input-group-text bg-light">$</span>
                <input type="number" step="0.01" class="form-control split-amount fw-bold text-end" placeholder="0.00" required />
            </div>
        </div>
        <div class="col-1 text-end">
            <button type="button" class="btn btn-sm text-danger p-0 btn-remove-split" title="Quitar cuenta" style="display:none;"><i class="fa-solid fa-times fs-5"></i></button>
        </div>
    </div>
</template>