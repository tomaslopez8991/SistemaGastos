@model SistemaGastos.Application.DTOs.DashboardVM
@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mb-5"
     data-intro="¡Bienvenido a SistemaGastos! Este es tu panel de control central donde verás un resumen rápido de tu situación financiera actual."
     data-step="1">
    <h1 class="display-4 fw-bold" style="text-shadow: 0 2px 10px rgba(0,0,0,0.5);">
        SistemaGastos <span class="text-primary">2.0</span>
    </h1>
    <p class="lead">Resumen financiero al @DateTime.Now.ToString("dd/MM/yyyy")</p>
</div>

<!-- ── Métricas principales ── -->
<div class="row g-4 mb-5"
     data-intro="Estas tarjetas te muestran tus métricas financieras clave del mes."
     data-step="2">

    <!-- Saldo Total -->
    <div class="col-md-3">
        <div class="card card-glass-modern border-0 h-100"
             data-intro="Saldo Total: suma de todo tu dinero disponible en cuentas bancarias y efectivo."
             data-step="3">
            <div class="gradient-overlay gradient-success"></div>
            <div class="card-body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div class="metric-badge bg-success bg-opacity-10">
                        <i class="fa-solid fa-wallet text-success fa-lg"></i>
                    </div>
                    <span class="badge text-success bg-success bg-opacity-10 border border-success">
                        <i class="fa-solid fa-trending-up me-1"></i>Activo
                    </span>
                </div>
                <p class="text-muted small mb-2 text-uppercase fw-semibold">Saldo Total</p>
                <h2 class="fw-bold mb-0 @(Model.SaldoTotal >= 0 ? "text-success" : "text-danger")" style="font-size: 2rem; letter-spacing: -1px;">
                    @Model.SaldoTotal.ToString("C")
                </h2>
            </div>
        </div>
    </div>

    <!-- Ingresos del Mes -->
    <div class="col-md-3">
        <div class="card card-glass-modern border-0 h-100"
             data-intro="Ingresos del Mes: total de entradas registradas en el mes actual."
             data-step="4">
            <div class="gradient-overlay" style="background: linear-gradient(135deg, rgba(32,201,151,.12) 0%, transparent 60%)"></div>
            <div class="card-body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div class="metric-badge" style="background:rgba(32,201,151,.15)">
                        <i class="fa-solid fa-arrow-trend-up fa-lg" style="color:#20c997"></i>
                    </div>
                    <span class="badge border" style="color:#20c997;background:rgba(32,201,151,.12);border-color:#20c997!important">
                        <i class="fa-solid fa-calendar me-1"></i>Mes
                    </span>
                </div>
                <p class="text-muted small mb-2 text-uppercase fw-semibold">Ingresos del Mes</p>
                <h2 class="fw-bold mb-0" style="font-size: 2rem; letter-spacing: -1px; color:#20c997">
                    @Model.IngresosMes.ToString("C")
                </h2>
            </div>
        </div>
    </div>

    <!-- Gastos Registrados -->
    <div class="col-md-3">
        <div class="card card-glass-modern border-0 h-100"
             data-intro="Gastos del Mes: cuánto gastaste en el mes actual."
             data-step="5">
            <div class="gradient-overlay gradient-danger"></div>
            <div class="card-body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div class="metric-badge bg-danger bg-opacity-10">
                        <i class="fa-solid fa-money-bill-wave text-danger fa-lg"></i>
                    </div>
                    <span class="badge text-danger bg-danger bg-opacity-10 border border-danger">
                        <i class="fa-solid fa-calendar me-1"></i>Mes
                    </span>
                </div>
                <p class="text-muted small mb-2 text-uppercase fw-semibold">Gastos del Mes</p>
                <h2 class="fw-bold mb-0 text-danger" style="font-size: 2rem; letter-spacing: -1px;">
                    @Model.GastosMes.ToString("C")
                </h2>
            </div>
        </div>
    </div>

    <!-- Balance Neto del Mes -->
    <div class="col-md-3">
        <div class="card card-glass-modern border-0 h-100"
             data-intro="Balance del Mes: diferencia entre ingresos y gastos. Positivo = ahorrás, negativo = gastás de más."
             data-step="6">
            <div class="gradient-overlay @(Model.BalanceMes >= 0 ? "gradient-success" : "gradient-danger")"></div>
            <div class="card-body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div class="metric-badge @(Model.BalanceMes >= 0 ? "bg-success bg-opacity-10" : "bg-danger bg-opacity-10")">
                        <i class="fa-solid @(Model.BalanceMes >= 0 ? "fa-scale-balanced text-success" : "fa-scale-unbalanced text-danger") fa-lg"></i>
                    </div>
                    <span class="badge @(Model.BalanceMes >= 0 ? "text-success bg-success bg-opacity-10 border border-success" : "text-danger bg-danger bg-opacity-10 border border-danger")">
                        @(Model.BalanceMes >= 0 ? "Superávit" : "Déficit")
                    </span>
                </div>
                <p class="text-muted small mb-2 text-uppercase fw-semibold">Balance del Mes</p>
                <h2 class="fw-bold mb-0 @(Model.BalanceMes >= 0 ? "text-success" : "text-danger")" style="font-size: 2rem; letter-spacing: -1px;">
                    @Model.BalanceMes.ToString("C")
                </h2>
            </div>
        </div>
    </div>

    <!-- Consumos Tarjeta -->
    <div class="col-md-4">
        <div class="card card-glass-modern border-0 h-100"
             data-intro="Deuda en Tarjetas: total de consumos pendientes de pago en tus tarjetas de crédito."
             data-step="7">
            <div class="gradient-overlay gradient-warning"></div>
            <div class="card-body p-4 position-relative">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div class="metric-badge bg-warning bg-opacity-10">
                        <i class="fa-regular fa-credit-card text-warning fa-lg"></i>
                    </div>
                    <span class="badge text-warning bg-warning bg-opacity-10 border border-warning">
                        <i class="fa-solid fa-exclamation me-1"></i>Deuda
                    </span>
                </div>
                <p class="text-muted small mb-2 text-uppercase fw-semibold">Consumos Tarjeta</p>
                <h2 class="fw-bold mb-0 text-warning" style="font-size: 2rem; letter-spacing: -1px;">
                    @Model.DeudaTarjetas.ToString("C")
                </h2>
            </div>
        </div>
    </div>

    <!-- Próximos Gastos Fijos -->
    @if (Model.ProximosGastosFijos.Count > 0)
    {
        <div class="col-md-8">
            <div class="card card-glass-modern border-0 h-100"
                 data-intro="Próximos Gastos Fijos: vencimientos que te quedan este mes."
                 data-step="8">
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="metric-badge bg-info bg-opacity-10">
                            <i class="fa-solid fa-calendar-check text-info fa-lg"></i>
                        </div>
                        <div>
                            <p class="text-muted small mb-0 text-uppercase fw-semibold">Próximos Gastos Fijos</p>
                            <small class="text-muted">Vencimientos restantes del mes</small>
                        </div>
                        <a asp-controller="FixedExpense" asp-action="Index" class="ms-auto btn btn-sm btn-outline-secondary">Ver todos</a>
                    </div>
                    <div class="d-flex flex-column gap-2">
                        @foreach (var gasto in Model.ProximosGastosFijos)
                        {
                            var diasRestantes = gasto.PaymentDay - DateTime.Now.Day;
                            var badgeClass = diasRestantes <= 3 ? "bg-danger" : diasRestantes <= 7 ? "bg-warning" : "bg-secondary";
                            <div class="d-flex align-items-center gap-3 px-3 py-2 rounded" style="background:rgba(255,255,255,.04)">
                                @if (!string.IsNullOrEmpty(gasto.LogoUrl))
                                {
                                    <img src="@gasto.LogoUrl" alt="@gasto.Name" style="width:28px;height:28px;object-fit:contain;border-radius:4px">
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center rounded" style="width:28px;height:28px;background:rgba(255,255,255,.08)">
                                        <i class="fa-solid fa-receipt text-muted" style="font-size:.7rem"></i>
                                    </div>
                                }
                                <span class="fw-semibold flex-grow-1 text-truncate">@gasto.Name</span>
                                <span class="text-muted small">día @gasto.PaymentDay</span>
                                <span class="badge @badgeClass">@(diasRestantes == 0 ? "Hoy" : $"en {diasRestantes}d")</span>
                                <span class="fw-bold text-danger small">@gasto.Amount.ToString("N0") @gasto.Currency</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-8">
            <div class="card card-glass-modern border-0 h-100">
                <div class="card-body p-4 d-flex align-items-center gap-3">
                    <div class="metric-badge bg-success bg-opacity-10">
                        <i class="fa-solid fa-circle-check text-success fa-lg"></i>
                    </div>
                    <div>
                        <p class="text-muted small mb-0 text-uppercase fw-semibold">Gastos Fijos</p>
                        <span class="text-success fw-semibold">Sin vencimientos pendientes este mes</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ── Módulos más usados (localStorage) ── -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
        <i class="fa-solid fa-fire me-2 text-warning"></i>Módulos más usados
    </h4>
    <button class="btn btn-sm btn-link text-muted" onclick="dashboardResetUsage()" title="Resetear contadores">
        <i class="fa-solid fa-rotate-left me-1"></i>Resetear
    </button>
</div>
<div class="row g-3 mb-5" id="most-used-modules">
    <!-- Rendered by JS -->
</div>

<!-- ── Accesos Rápidos ── -->
<h4 class="mb-3"
    data-intro="Accesos Rápidos: estos botones te llevan directamente a los módulos principales del sistema."
    data-step="9">
    <i class="fa-solid fa-rocket me-2"></i>Accesos Rápidos
</h4>

<div class="row g-3 mb-4"
     data-intro="Desde aquí puedes acceder rápidamente a las funciones principales."
     data-step="10">

    <div class="col-6 col-md-2">
        <a asp-controller="TmpTransaction" asp-action="Index"
           class="card card-action h-100 text-decoration-none shadow-sm module-link"
           data-module="Proyección">
            <div class="card-body text-center">
                <div class="icon-wrapper mb-3">
                    <i class="fa-solid fa-calculator fa-3x text-info"></i>
                </div>
                <h6 class="mb-0 fw-bold">Proyección</h6>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-2">
        <a asp-controller="CreditCardTransaction" asp-action="Index"
           class="card card-action h-100 text-decoration-none shadow-sm module-link"
           data-module="Tarjetas">
            <div class="card-body text-center">
                <div class="icon-wrapper mb-3">
                    <i class="fa-solid fa-credit-card fa-3x text-primary"></i>
                </div>
                <h6 class="mb-0 fw-bold">Calculadora TC</h6>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-2">
        <a asp-controller="Transaction" asp-action="Index"
           class="card card-action h-100 text-decoration-none shadow-sm module-link"
           data-module="Transacciones">
            <div class="card-body text-center">
                <div class="icon-wrapper mb-3">
                    <i class="fa-solid fa-money-bill-transfer fa-3x text-success"></i>
                </div>
                <h6 class="mb-0 fw-bold">Transacciones</h6>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-2">
        <a asp-controller="Todo" asp-action="Index"
           class="card card-action h-100 text-decoration-none shadow-sm module-link"
           data-module="Tareas">
            <div class="card-body text-center">
                <div class="icon-wrapper mb-3 position-relative d-inline-block">
                    <i class="fa-solid fa-list-check fa-3x text-warning"></i>
                    @if (Model.TareasPendientes > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                            @Model.TareasPendientes
                        </span>
                    }
                </div>
                <h6 class="mb-0 fw-bold">Tareas</h6>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-2">
        <a asp-controller="Transaction" asp-action="Statistics"
           class="card card-action h-100 text-decoration-none shadow-sm module-link"
           data-module="Estadísticas">
            <div class="card-body text-center">
                <div class="icon-wrapper mb-3">
                    <i class="fas fa-chart-line fa-3x text-info"></i>
                </div>
                <h6 class="mb-0 fw-bold">Estadísticas</h6>
            </div>
        </a>
    </div>

    <div class="col-6 col-md-2">
        <a asp-controller="Person" asp-action="Index"
           class="card card-action h-100 text-decoration-none shadow-sm module-link"
           data-module="Cuentas">
            <div class="card-body text-center">
                <div class="icon-wrapper mb-3">
                    <i class="fa-solid fa-people-group fa-3x text-secondary"></i>
                </div>
                <h6 class="mb-0 fw-bold">Cuentas</h6>
            </div>
        </a>
    </div>

</div>

@section Scripts {
<script src="~/js/dashboard.js" asp-append-version="true"></script>
}
